@model MinCoreBank.Models.GlTransaction

@{
    ViewData["Title"] = "تفاصيل قيد الأستاذ العام";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="details-shell">
    <section class="details-hero">
        <div>
            <span class="hero-chip">تفاصيل القيد</span>
            <h1 class="page-title mb-1">@ViewData["Title"]</h1>
            <p class="page-subtitle mb-0">عرض منظم لبيانات القيد مع بطاقات معلومات تتماشى مع واجهة النظام الحالية.</p>
        </div>
        <div class="hero-actions">
           
            <a href="@Url.Action("Index", "GlTransactionsView")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-1"></i>العودة للقائمة
            </a>
        </div>
    </section>

    <section class="details-grid">
        <article class="stat-card">
            <span class="stat-label">رقم المرجع</span>
            <strong class="stat-value">@Model.TransactionRef</strong>
            <span class="stat-meta">مرجع القيد الأساسي</span>
        </article>
        <article class="stat-card">
            <span class="stat-label">الحساب العام</span>
            <strong class="stat-value">@(Model.GlId?.ToString() ?? "-")</strong>
            <span class="stat-meta">@(string.IsNullOrWhiteSpace(Model.GlName) ? "غير محدد" : Model.GlName)</span>
        </article>
        <article class="stat-card">
            <span class="stat-label">الحركة المدينة</span>
            <strong class="stat-value text-danger">@((Model.DebitAccount ?? 0).ToString("N2"))</strong>
            <span class="stat-meta">دينار / قيمة مدينة</span>
        </article>
        <article class="stat-card">
            <span class="stat-label">الحركة الدائنة</span>
            <strong class="stat-value text-success">@((Model.CreditAccount ?? 0).ToString("N2"))</strong>
            <span class="stat-meta">دينار / قيمة دائنة</span>
        </article>
    </section>

    <section class="surface-card">
        <div class="section-head">
            <h2>بيانات القيد</h2>
            <p>تفاصيل الإنشاء والحالة والوصف.</p>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">اسم الحساب</span>
                <div class="info-value">@Model.GlName</div>
            </div>
            <div class="info-item">
                <span class="info-label">العملة</span>
                <div class="info-value">@Model.Currency</div>
            </div>
            <div class="info-item">
                <span class="info-label">الحالة</span>
                <div class="info-value">
                    <span class="status-chip @(Model.Status == "completed" ? "ok" : Model.Status == "returned" ? "warn" : "neutral")">
                        @(Model.Status == "completed" ? "مكتمل" : Model.Status == "returned" ? "مرتجع" : "قيد المعالجة")
                    </span>
                </div>
            </div>
            <div class="info-item">
                <span class="info-label">تاريخ الإنشاء</span>
                <div class="info-value">@Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
            <div class="info-item">
                <span class="info-label">تم الإنشاء بواسطة</span>
                <div class="info-value">@(string.IsNullOrWhiteSpace(Model.CreatedBy) ? "-" : Model.CreatedBy)</div>
            </div>
            <div class="info-item">
                <span class="info-label">الوصف</span>
                <div class="info-value multiline">@(string.IsNullOrWhiteSpace(Model.DescriptionAr) ? "-" : Model.DescriptionAr)</div>
            </div>
        </div>
    </section>
</div>

@section Styles {
    <style>
        .details-shell { display: grid; gap: 16px; }
        .details-hero {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            padding: 16px 18px;
            border: 1px solid var(--line);
            border-radius: 18px;
            background: linear-gradient(145deg, #fbfdff 0%, #f3f7fd 100%);
            box-shadow: 0 12px 24px rgba(10, 37, 74, 0.06);
        }
        .hero-chip {
            display: inline-flex;
            padding: 6px 10px;
            border-radius: 999px;
            background: #eaf2ff;
            color: #21508d;
            font-size: .78rem;
            font-weight: 800;
            margin-bottom: 8px;
        }
        .page-title { color: var(--ink); font-size: 1.7rem; font-weight: 900; }
        .page-subtitle { color: var(--muted); font-size: .95rem; font-weight: 600; }
        .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .details-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
        .stat-card,
        .surface-card {
            border: 1px solid var(--line);
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 12px 24px rgba(10, 37, 74, 0.08);
        }
        .stat-card { padding: 16px 18px; }
        .stat-label { display: block; color: var(--muted); font-size: .82rem; font-weight: 700; margin-bottom: 6px; }
        .stat-value { display: block; color: var(--ink); font-size: 1.16rem; font-weight: 900; }
        .stat-meta { display: block; color: #607594; font-size: .84rem; font-weight: 600; margin-top: 4px; }
        .surface-card { padding: 20px; }
        .section-head { margin-bottom: 16px; }
        .section-head h2 { margin: 0 0 6px; color: var(--ink); font-size: 1.18rem; font-weight: 800; }
        .section-head p { margin: 0; color: var(--muted); font-size: .9rem; font-weight: 600; }
        .info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .info-item {
            border: 1px solid #e6edf6;
            border-radius: 14px;
            background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
            padding: 14px 16px;
            min-height: 92px;
        }
        .info-label { display: block; color: var(--muted); font-size: .82rem; font-weight: 700; margin-bottom: 8px; }
        .info-value { color: var(--ink); font-size: .98rem; font-weight: 700; line-height: 1.8; }
        .info-value.multiline { white-space: pre-wrap; word-break: break-word; }
        .status-chip {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: .82rem;
            font-weight: 800;
            border: 1px solid transparent;
        }
        .status-chip.ok { background: #e8f8ee; color: #157a3f; border-color: #bfe8cd; }
        .status-chip.warn { background: #fff5e9; color: #945b16; border-color: #f4d8ad; }
        .status-chip.neutral { background: #eef3f8; color: #4d647f; border-color: #d9e2ed; }
        @@media (max-width: 992px) {
            .details-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .info-grid { grid-template-columns: 1fr; }
        }
        @@media (max-width: 576px) {
            .details-grid { grid-template-columns: 1fr; }
            .details-hero,
            .surface-card { padding: 14px; }
        }
    </style>
}
