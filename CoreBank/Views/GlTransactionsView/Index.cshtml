@model MinCoreBank.Models.GlTransactionsIndexViewModel
@{
    ViewData["Title"] = "إدارة قيود الاستاذ العام";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
    string branchId = ViewBag.BranchId;
}
<div class="banking-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title"><i class="fas fa-exchange-alt me-2"></i>@ViewData["Title"]</h1>
        <div class="d-flex gap-2">
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"><i class="fas fa-calendar-week me-1"></i>الفترة</button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { period = "today", page = 1, branchId })">اليوم</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { period = "week", page = 1, branchId })">هذا الأسبوع</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { period = "month", page = 1, branchId })">هذا الشهر</a></li>
                    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#periodModal">مخصص</button></li>
                </ul>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#previewModal"><i class="fas fa-plus-circle me-2"></i>إنشاء قيد جديد</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="banking-card"><div class="card-body"><div class="text-muted">إجمالي الدائن</div><div class="fs-4 fw-bold text-success">@Model.TotalCredit.ToString("N2")</div></div></div></div>
        <div class="col-md-4"><div class="banking-card"><div class="card-body"><div class="text-muted">إجمالي المدين</div><div class="fs-4 fw-bold text-danger">@Model.TotalDebit.ToString("N2")</div></div></div></div>
        <div class="col-md-4"><div class="banking-card"><div class="card-body"><div class="text-muted">حالة الميزانية</div><div class="fs-4 fw-bold">@Model.BalanceStatus</div></div></div></div>
    </div>

    <div class="banking-card">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-3"><p class="text-muted mb-0">عرض <strong>@Math.Min(pageSize, Model.Transactions.Count())</strong> من أصل <strong>@totalCount</strong> قيد</p><p class="text-muted mb-0">الصفحة <strong>@currentPage</strong> من <strong>@totalPages</strong></p></div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover banking-table" id="transactionsTable">
                    <thead><tr><th>رقم الدليل</th><th>اسم الحساب</th><th>الحركة المدينة DR</th><th>الحركة الدائنة CR</th><th>تاريخ الإنشاء</th><th>الإجراءات</th></tr></thead>
                    <tbody>
                    @foreach (var transaction in Model.Transactions)
                    {
                        <tr>
                            <td>@transaction.GlId</td><td>@transaction.GlName</td><td>@transaction.DebitAccount</td><td>@transaction.CreditAccount</td><td>@transaction.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><a href="@Url.Action("Details", new { id = transaction.Id })" class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="periodModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">فترة مخصصة</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form method="get"><input type="hidden" name="period" value="custom"/><input type="hidden" name="branchId" value="@branchId"/><div class="mb-2"><label class="form-label">من</label><input type="date" class="form-control" name="from" required></div><div class="mb-2"><label class="form-label">إلى</label><input type="date" class="form-control" name="to" required></div><button class="btn btn-primary">تطبيق</button></form></div></div></div></div>

<div class="modal fade preview-modal" id="previewModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header py-2"><h5 class="modal-title fs-6"><i class="fas fa-plus-circle me-1"></i>إنشاء قيد جديد</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body p-3"><form id="createTransactionForm" class="row g-2">
            <div class="col-md-6"><label for="GlIdInput" class="form-label small mb-1">رقم الاستاذ العام <span class="text-danger">*</span></label><input class="form-control form-control-sm" id="GlIdInput" name="GlId" inputmode="numeric" required><div class="invalid-feedback" id="glIdValidation">رقم الأستاذ العام غير موجود.</div></div>
            <div class="col-md-6"><label for="GlName" class="form-label small mb-1">اسم الاستاذ العام</label><input type="text" class="form-control form-control-sm" id="GlName" name="GlName" readonly></div>
            <input type="hidden" id="Date" name="Date"><input type="hidden" id="ValueDate" name="ValueDate"><input type="hidden" id="Currency" name="Currency" value="IQD">
            <div class="col-md-6"><label for="DebitAccount" class="form-label small mb-1">الحساب المدين <span class="text-danger">*</span></label><input type="text" class="form-control form-control-sm" id="DebitAccount" name="DebitAccount" required></div>
            <div class="col-md-6"><label for="CreditAccount" class="form-label small mb-1">الحساب الدائن <span class="text-danger">*</span></label><input type="text" class="form-control form-control-sm" id="CreditAccount" name="CreditAccount" required></div>
            <div class="col-12"><label for="DescriptionAr" class="form-label small mb-1">الوصف</label><textarea class="form-control form-control-sm" id="DescriptionAr" name="DescriptionAr" rows="2"></textarea></div>
        </form></div>
        <div class="modal-footer py-2"><button type="button" class="btn btn-primary btn-sm" id="submitTransaction"><i class="fas fa-save me-1"></i>حفظ القيد</button><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button></div>
    </div></div>
</div>

@section Scripts {
<script>
$(function () {
 const today = new Date().toISOString().split('T')[0]; $('#Date').val(today); $('#ValueDate').val(today);
 async function lookupGl(){const id=$('#GlIdInput').val().trim(); if(!id){return false;} try{const r=await fetch(`/api/gltransactionsview/account/${id}`); if(!r.ok) throw new Error(); const d=await r.json(); $('#GlName').val(d.nameAr); $('#GlIdInput').removeClass('is-invalid'); return true;}catch{ $('#GlName').val(''); $('#GlIdInput').addClass('is-invalid').focus(); return false;}}
 $('#GlIdInput').on('keydown', async function(e){ if(e.key==='Enter'){e.preventDefault(); await lookupGl();}});
 $('#submitTransaction').on('click', async function(){ if(!await lookupGl()) return; const formData={GlName:$('#GlName').val(),GlId:$('#GlIdInput').val(),Date:$('#Date').val(),ValueDate:$('#Date').val(),DebitAccount:$('#DebitAccount').val(),CreditAccount:$('#CreditAccount').val(),Amount:0.01,Currency:'IQD',FxRate:1.0,DescriptionAr:$('#DescriptionAr').val(),DescriptionEn:'',BranchId:'@ViewBag.UserBranchCode',CbiCode:''};
 $.ajax({url:'/api/GlTransactions/createtrans',type:'POST',contentType:'application/json',data:JSON.stringify(formData),success:function(){alert('تم إنشاء القيد بنجاح!');location.reload();},error:function(){alert('حدث خطأ أثناء إنشاء القيد.');}});
 });
});
</script>
}
