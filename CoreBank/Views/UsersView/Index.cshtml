</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">تأكيد الإجراء</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmationMessage">هل أنت متأكد من أنك تريد تنفيذ هذا الإجراء؟</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-danger" id="confirmActionBtn">تأكيد</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .banking-card {
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 14px 28px rgba(10, 37, 74, 0.08);
            overflow: hidden;
        }

        .banking-card .card-header {
            background: linear-gradient(180deg, #fbfdff 0%, #f3f8ff 100%);
            border-bottom: 1px solid var(--line);
            padding: 16px 18px;
        }

        .banking-card .card-body {
            padding: 18px;
        }

        .users-search-group .form-control {
            background: #f8fbff;
            border-color: var(--line);
            min-height: 42px;
        }

        .users-search-btn {
            min-width: 46px;
            border-color: var(--line);
            color: #173a64;
            background: #f8fbff;
        }

        .users-summary-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 9px 14px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: #f6f9ff;
            color: #173a64;
            font-size: .88rem;
            font-weight: 700;
        }

        .banking-table th {
            background-color: #1a3a6c;
            color: white;
            border-color: #1a3a6c;
            font-weight: 700;
            text-align: center;
        }

        .banking-table td {
            vertical-align: middle;
        }

        .banking-table tbody tr:nth-child(even) {
            background: #fbfdff;
        }

        .table-responsive {
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
        }

        .pagination .page-link {
            border-radius: 10px;
            color: #173a64;
            border-color: var(--line);
            margin: 0 2px;
        }

        .pagination .page-item.active .page-link {
            background: linear-gradient(90deg, #123c78, #0c2e61);
            border-color: #123c78;
        }

        .badge {
            font-size: 0.85em;
        }

        .btn-group-sm > .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load branches for dropdowns
            loadBranches();

            // Search functionality
            $('#searchButton').on('click', filterTable);
            $('#searchInput').on('keyup', filterTable);

            // Create user
            $('#createUserBtn').on('click', createUser);

            // Update user
            $('#updateUserBtn').on('click', updateUser);

            // View user details
            $('.view-user').on('click', function() {
                const userId = $(this).data('user-id');
                viewUser(userId);
            });

            // Edit user
            $('.edit-user').on('click', function() {
                const userId = $(this).data('user-id');
                editUser(userId);
            });

            // Suspend user
            $('.suspend-user').on('click', function() {
                const userId = $(this).data('user-id');
                showConfirmation('هل أنت متأكد من تعليق هذا المستخدم؟', function() {
                    updateUserStatus(userId, 'suspended');
                });
            });

            // Activate user
            $('.activate-user').on('click', function() {
                const userId = $(this).data('user-id');
                showConfirmation('هل أنت متأكد من اعادة تفعيل هذا المستخدم؟', function() {
                    updateUserStatus(userId, 'active');
                });
            });

            // Delete user
            $('.delete-user').on('click', function() {
                const userId = $(this).data('user-id');
                showConfirmation('هل أنت متأكد من أنك تريد حذف هذا المستخدم؟ هذا الإجراء لا يمكن التراجع عنه.', function() {
                    deleteUser(userId);
                });
            });

            function loadBranches() {
                // This would typically call an API to get branches
                // For now, we'll simulate with static data
                const branches = [
                           
            { id: '721', name: 'رئيسي (721)' },
            { id: '722', name: 'بغداد العطيفية (722)' },
            { id: '723', name: 'ديالى (723)' },
            { id: '724', name: 'ديوانية (724)' },
            { id: '725', name: 'تلعفر (725)' },
            { id: '727', name: 'نجف (727)' },
            { id: '728', name: 'عزيزية (728)' },
            { id: '729', name: 'كربلاء (729)' },
            { id: '730', name: 'كوت (730)' },
            { id: '731', name: 'محمودية (731)' },
