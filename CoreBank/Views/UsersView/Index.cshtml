            function filterTable() {
                const searchText = $('#searchInput').val().toLowerCase();
                $('#usersTable tbody tr').each(function() {
                    const id = $(this).find('td:eq(0)').text().toLowerCase();
                    const nameAr = $(this).find('td:eq(1)').text().toLowerCase();
                    const nameEn = $(this).find('td:eq(2)').text().toLowerCase();

                    if (id.includes(searchText) || nameAr.includes(searchText) || nameEn.includes(searchText)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            function createUser() {
                       const formData = {
            NameAr: $('#NameAr').val(),
            NameEn: $('#NameEn').val(),
            Role: $('#Role').val(), 
            BranchId:$('#BranchId').val(),  
            Password: $('#Password').val()
        };
     
       
                // Validate passwords match
                if ($('#Password').val() !== $('#ConfirmPassword').val()) {
                    alert('كلمات المرور غير متطابقة');
                    return;
                }

                // Validate all required fields
                if (!formData.NameAr || !formData.NameEn || !formData.Role || !formData.BranchId || !formData.Password) {
                    alert('يرجى ملء جميع الحقول المطلوبة');
                    return;
                }
                  
                $.ajax({
                    url: '/api/Users/CreateUser', // Fixed endpoint URL
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            alert('تم إنشاء المستخدم بنجاح!');
                            $('#createUserModal').modal('hide');
                            window.location.reload();
                        } else {
                            alert('فشل في إنشاء المستخدم: ' + response.message);
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = 'حدث خطأ أثناء إنشاء المستخدم. يرجى المحاولة مرة أخرى.';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseJSON && xhr.responseJSON.errors) {
                            // Handle validation errors
                            const errors = Object.values(xhr.responseJSON.errors).flat();
                            errorMessage = 'أخطاء في البيانات:\n' + errors.join('\n');
                        }

                        alert(errorMessage);
                    }
                });
            }

            function viewUser(userId) {
                $.ajax({
                    url: `/api/Users/${userId}`,
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            const user = response.data;
                            $('#viewUserId').text(user.id);
                            $('#viewNameAr').text(user.name_ar);
                            $('#viewNameEn').text(user.name_en);
                            $('#viewRole').text(user.role);
                            $('#viewBranch').text(user.branchId);
                            $('#viewStatus').text(user.status === 'active' ? 'نشط' : user.status === 'suspended' ? 'موقوف' : 'معطل');
                            $('#viewLastLogin').text(user.lastLogin ? new Date(user.lastLogin).toLocaleString() : 'لم يسجل دخول');
                            $('#viewCreatedAt').text(new Date(user.createdAt).toLocaleDateString());

                            $('#viewUserModal').modal('show');
                        } else {
                            alert('فشل في تحميل بيانات المستخدم: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('حدث خطأ أثناء تحميل بيانات المستخدم.');
                    }
                });
            }

            function editUser(userId) {
                $.ajax({
                    url: `/api/Users/${userId}`,
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            const user = response.data;
                            $('#EditUserId').val(user.id);
                            $('#EditNameAr').val(user.name_ar);
                            $('#EditNameEn').val(user.name_en);
                            $('#EditRole').val(user.role);
                            $('#EditStatus').val(user.status);

                            $('#editUserModal').modal('show');
                        } else {
                            alert('فشل في تحميل بيانات المستخدم: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('حدث خطأ أثناء تحميل بيانات المستخدم.');
                    }
                });
            }

            function updateUser() {
                const userId = $('#EditUserId').val();
                const formData = {
                    NameAr: $('#EditNameAr').val(),
                    NameEn: $('#EditNameEn').val(),
                    Role: $('#EditRole').val(),
                    Status: $('#EditStatus').val()
                };

                // Validate all required fields
                if (!formData.NameAr || !formData.NameEn || !formData.Role || !formData.Status) {
                    alert('يرجى ملء جميع الحقول المطلوبة');
                    return;
                }

                $.ajax({
                    url: `/api/Users/UpdateUser/${userId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            alert('تم تحديث المستخدم بنجاح!');
                            $('#editUserModal').modal('hide');
                            window.location.reload();
                        } else {
                            alert('فشل في تحديث المستخدم: ' + response.message);
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = 'حدث خطأ أثناء تحديث المستخدم. يرجى المحاولة مرة أخرى.';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseJSON && xhr.responseJSON.errors) {
                            // Handle validation errors
                            const errors = Object.values(xhr.responseJSON.errors).flat();
                            errorMessage = 'أخطاء في البيانات:\n' + errors.join('\n');
                        }

                        alert(errorMessage);
                    }
                });
            }

