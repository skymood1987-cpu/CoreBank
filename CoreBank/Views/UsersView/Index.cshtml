                    <input type="hidden" id="EditUserId" name="Id">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditNameAr" class="form-label">الاسم العربي <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="EditNameAr" name="NameAr" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="EditNameEn" class="form-label">الاسم الإنجليزي <span class="text-danger">*</span></label>
