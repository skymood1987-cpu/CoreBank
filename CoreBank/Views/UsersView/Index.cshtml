@model IEnumerable<MinCoreBank.Models.Users>

@{
    ViewData["Title"] = "إدارة المستخدمين النهائيين";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get pagination data from ViewBag
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
    string statusFilter = ViewBag.StatusFilter;
    string roleFilter = ViewBag.RoleFilter;
    string branchFilter = ViewBag.BranchFilter;
    string searchTerm = ViewBag.SearchTerm;
    string branchid_ = ViewBag.branchid;
}

<div class="banking-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-users fa-lg me-2"></i>@ViewData["Title"]
        </h1>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="fas fa-plus-circle me-2"></i>إضافة مستخدم جديد
        </button>
    </div>

    <!-- Users Table -->
    <div class="banking-card">
        <div class="card-header">
            <div class="row align-items-center g-3">
                <div class="col-lg-5 col-md-7">
                    <div class="input-group users-search-group">
                        <input type="text" id="searchInput" class="form-control" placeholder="ابحث بالاسم أو المعرف...">
                        <button class="btn btn-outline-secondary users-search-btn" type="button" id="searchButton">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-7 col-md-5 text-md-end">
                    <div class="users-summary-chip">
                        <i class="fas fa-users me-2"></i>
                        إجمالي المستخدمين: <strong>@totalCount</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <!-- Pagination Info -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <p class="text-muted">
                        عرض <strong>@(Math.Min(pageSize, Model.Count()))</strong> من أصل <strong>@totalCount</strong> مستخدم
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <p class="text-muted">
                        الصفحة <strong>@currentPage</strong> من <strong>@totalPages</strong>
                    </p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover banking-table" id="usersTable">
                    <thead class="table-dark">
                        <tr>
                            <th>المعرف</th>
                            <th>الاسم العربي</th>
                            <th>الاسم الإنجليزي</th>
                            <th>الدور</th>
                            <th>الفرع</th>
                            <th>الحالة</th>
                            <th>آخر تسجيل دخول</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.Id</td>
                                <td>@user.Name_ar</td>
                                <td>@user.Name_en</td>
                                <td>
                                    @switch (user.Role?.ToLower())
                                    {
                                        case "admin":
                                            <span class="badge bg-danger">@user.Role</span>
                                            break;
                                        case "manager":
                                            <span class="badge bg-primary">@user.Role</span>
                                            break;
                                        case "teller":
                                            <span class="badge bg-info">@user.Role</span>
                                            break;
                                        case "auditor":
                                            <span class="badge bg-warning text-dark">@user.Role</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@user.Role</span>
                                            break;
                                    }
                                </td>
                                <td>@user.BranchId</td>
                                <td>
                                    <span class="badge @(user.Status == "active" ? "bg-success" : user.Status == "suspended" ? "bg-warning" : "bg-secondary")">
                                        @(user.Status == "active" ? "نشط" : user.Status == "suspended" ? "موقوف" : "معطل")
                                    </span>
                                </td>
                                <td>@(user.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "لم يسجل دخول")</td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-info view-user" data-user-id="@user.Id">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary edit-user" data-user-id="@user.Id">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @if (user.Status == "active")
                                        {
                                            <button type="button" class="btn btn-outline-warning suspend-user" data-user-id="@user.Id">
                                                <i class="fas fa-pause"></i>
                                            </button>
                                        }
                                        else if (user.Status == "suspended")
                                        {
                                            <button type="button" class="btn btn-outline-success activate-user" data-user-id="@user.Id">
                                                <i class="fas fa-play"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-danger delete-user" data-user-id="@user.Id">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <!-- First Page -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = 1, statusFilter, roleFilter, branchFilter, searchTerm })">
                                <i class="fas fa-angle-double-right"></i>
                            </a>
                        </li>

                        <!-- Previous Page -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, statusFilter, roleFilter, branchFilter, searchTerm })">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, statusFilter, roleFilter, branchFilter, searchTerm })">@i</a>
                            </li>
                        }

                        <!-- Next Page -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, statusFilter, roleFilter, branchFilter, searchTerm })">
                                <i class="fas fa-angle-left"></i>
                            </a>
                        </li>

                        <!-- Last Page -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = totalPages, statusFilter, roleFilter, branchFilter, searchTerm })">
                                <i class="fas fa-angle-double-left"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">لا توجد مستخدمين مسجلين</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createUserModalLabel">
