                                    <option value="723">ديالى (723)</option>
                                    <option value="724">ديوانية (724)</option>
                                    <option value="725">تلعفر (725)</option>
                                    <option value="727">نجف (727)</option>
                                    <option value="728">عزيزية (728)</option>
                                    <option value="729">كربلاء (729)</option>
                                    <option value="730">كوت (730)</option>
                                    <option value="731">محمودية (731)</option>
                                    <option value="732">كركوك (732)</option>
                                    <option value="733">مسيب (733)</option>
                                    <option value="734">حلة (734)</option>
                                    <option value="736">ميسان (736)</option>
                                    <option value="737">بصرة (737)</option>
                                    <option value="738">ناصرية (738)</option>
                                    <option value="739">موصل (739)</option>
                                    <option value="740">رمادي (740)</option>
                                    <option value="741">تكريت (741)</option>
                                    <option value="745">صويرة (745)</option>
                                    <option value="753">سماوة (753)</option>
                                    <option value="754">قرنة (754)</option>
                                    <option value="755">هندية (755)</option>
                                    <option value="756">خالص (756)</option>
                                    <option value="759">طارمية (759)</option>
                                    <option value="760">هاشمية (760)</option>
                                    <option value="762">تجهيزات (762)</option>
                                    <option value="764">بلد (764)</option>
                                    <option value="774">مدائن (774)</option>
                                    <option value="784">سامراء (784)</option>
                                    <option value="830">مقدادية (830)</option>
                                    <option value="833">م. شركة مابين النهرين العامة للبذور (833)</option>
                                    <option value="750">قسم المالي (750)</option>
                                    <option value="751">قسم الدفع الالكتروني (751)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Password" class="form-label">كلمة المرور <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="Password" name="Password" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="ConfirmPassword" class="form-label">تأكيد كلمة المرور <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="createUserBtn">حفظ</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
