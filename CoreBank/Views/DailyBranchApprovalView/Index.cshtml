@model MinCoreBank.Models.ViewModels.DailyBranchApprovalViewModel
@{
    ViewData["Title"] = "إجراءات نهاية اليوم";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="banking-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-check-circle fa-lg me-2"></i>@ViewData["Title"]
        </h1>
    </div>

    <div class="banking-card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-calendar-day me-2"></i>حالة الموافقة ليوم @Model.Today.ToString("yyyy-MM-dd")
            </h5>
        </div>
        <div class="card-body">
            <!-- Approval Action -->
            <div class="text-center mt-4">
                @if (Model.IsApprovedToday)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>تمت الموافقة على الفرع اليوم</strong>
                        <br>
                        @if (Model.TodayApproval != null)
                        {
                            <small>بواسطة: @Model.TodayApproval.ApprovedBy | في: @Model.TodayApproval.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                        }
                    </div>
                    <button class="btn btn-success" disabled>
                        <i class="fas fa-lock me-2"></i>تمت الموافقة والقفل
                    </button>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>لم تتم الموافقة على الفرع اليوم</strong>
                    </div>
                    <button type="button" class="btn btn-primary btn-lg" onclick="approveBranch()" id="approveButton" @(Model.IsBalanced ? "" : "disabled")>
                        <i class="fas fa-check-circle me-2"></i>موافقة وقفل الفرع
                    </button>
                    @if (!Model.IsBalanced)
                    {
                        <div class="mt-2">
                            <small class="text-danger">لا يمكن الموافقة على الفرع لأن إجمالي الدائن (@Model.TotalCredit.ToString("N2")) لا يساوي إجمالي المدين (@Model.TotalDebit.ToString("N2"))</small>
                        </div>
                    }
                    else
                    {
                        <div class="mt-2">
                            <small class="text-muted">سيتم الموافقة على المعاملات الحالية وقفل الفرع ليوم @Model.Today.ToString("yyyy-MM-dd")</small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Quick Balance Check -->
    <div class="banking-card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-balance-scale me-2"></i>فحص الرصيد السريع
            </h5>
        </div>
        <div class="card-body text-center">
            <button type="button" class="btn btn-outline-info" onclick="checkBalance()">
                <i class="fas fa-sync-alt me-2"></i>تحديث بيانات الرصيد
            </button>
            <div id="balanceResult" class="mt-3"></div>
        </div>
    </div>
</div>

<!-- Manager Approval Modal -->
<div class="modal fade" id="notesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">اعتماد المدير - موافقة وقفل الفرع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div id="approvalCredentialError" class="alert alert-danger d-none py-2 mb-3"></div>
                <div class="mb-3">
                    <label for="managerUsername" class="form-label">اسم المستخدم (المدير)</label>
                    <input type="text" id="managerUsername" class="form-control" placeholder="أدخل اسم المستخدم للمدير">
                </div>
                <div class="mb-3">
                    <label for="managerPassword" class="form-label">كلمة المرور</label>
                    <input type="password" id="managerPassword" class="form-control" placeholder="أدخل كلمة المرور">
                </div>
                <textarea id="approvalNotes" class="form-control" rows="4" placeholder="أدخل أي ملاحظات إضافية (اختياري)..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" onclick="confirmApproval()">تأكيد الموافقة</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .banking-container {
            padding: 8px;
        }

        .page-title {
            color: var(--ink);
            font-weight: 700;
            font-size: 1.55rem;
        }

        .banking-card {
            background: var(--panel);
            border-radius: 14px;
            box-shadow: 0 12px 24px rgba(10, 37, 74, 0.08);
            margin-bottom: 16px;
            border: 1px solid var(--line);
        }

        .banking-card .card-header {
            background-color: #f8fbff;
            border-bottom: 1px solid var(--line);
            padding: 1rem 1.25rem;
            font-weight: 700;
            border-radius: 14px 14px 0 0 !important;
        }

        .banking-card .card-header h5 {
            margin: 0;
            color: var(--ink);
        }

        .card-body {
            padding: 20px;
        }

        .btn-lg {
            padding: 12px 30px;
            font-size: 18px;
            border-radius: 8px;
        }

        .alert {
            border-radius: 8px;
            border: 1px solid var(--line);
            padding: 15px 20px;
        }

        .alert-success {
            background-color: #eef8f2;
            color: #14613d;
        }

        .alert-warning {
            background-color: #fff8ea;
            color: #7d4f10;
        }

        .alert-info {
            background-color: #edf3ff;
            color: #173d76;
        }

        .text-muted {
            color: var(--muted) !important;
        }

        .text-primary {
            color: var(--brand) !important;
        }

        .btn-success:disabled {
            background-color: #6c757d;
            border-color: #6c757d;
            opacity: 1;
        }

        .modal-header {
            background: #123c78;
            color: white;
        }

        .modal-title {
            font-weight: 600;
        }

        .btn-close {
            filter: invert(1);
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.88);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

        /* Print styles */
        @@media print {
            .btn, .modal-footer, .alert {
                display: none !important;
            }

            .modal-dialog {
                max-width: 100% !important;
                margin: 0 !important;
            }

            .modal-content {
                border: none !important;
                box-shadow: none !important;
            }

            .banking-card {
                box-shadow: none !important;
                border: 1px solid #000 !important;
            }
        }
            .banking-container { padding: 8px !important; }
        .page-title { color: var(--ink) !important; font-size: 1.55rem !important; font-weight: 800 !important; }
        .banking-card { background: var(--panel) !important; border: 1px solid var(--line) !important; border-radius: 14px !important; box-shadow: 0 12px 24px rgba(10, 37, 74, 0.08) !important; }
        .banking-card .card-header { background: #f8fbff !important; border-bottom: 1px solid var(--line) !important; }
        .btn-primary { background: linear-gradient(90deg, var(--brand), var(--brand-2)) !important; border-color: var(--brand) !important; }
        .btn-primary:hover { background: linear-gradient(90deg, #164989, #0f356f) !important; border-color: #164989 !important; }
    </style>
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function approveBranch() {
            $('#notesModal').modal('show');
        }

        function confirmApproval() {
            const notes = $('#approvalNotes').val();
            const managerUsername = $('#managerUsername').val().trim();
            const managerPassword = $('#managerPassword').val();
            const token = document.querySelector('input[name=\"__RequestVerificationToken\"]')?.value;

            clearCredentialError();

            if (!managerUsername || !managerPassword) {
                showCredentialError('يرجى إدخال اسم المستخدم وكلمة المرور للمدير');
                return;
            }

            showLoading('جاري الموافقة على الفرع...');

            fetch('/DailyBranchApprovals/ApproveToday', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({
                    notes: notes,
                    managerUsername: managerUsername,
                    managerPassword: managerPassword
                })
            })
            .then(response => response.json())
            .then(data => {
                hideLoading();

                if (data.success) {
                    $('#notesModal').modal('hide');
                    showSuccess(data.message);
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } else {
                    showCredentialError(data.message || 'تعذر التحقق من بيانات المدير');
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Error:', error);
                showCredentialError('حدث خطأ أثناء الموافقة على الفرع');
            });
        }

        function checkBalance() {
            showLoading('جاري فحص الرصيد...');

            // In a real application, you would make an AJAX call here
            // For now, we'll simulate with a timeout
            setTimeout(() => {
                hideLoading();
                const balanceResult = document.getElementById('balanceResult');
                const isBalanced = @Model.IsBalanced.ToString().ToLower();
                const statusText = isBalanced ? "مطابق" : "غير مطابق";
                const statusClass = isBalanced ? "text-success" : "text-danger";

                let differenceHtml = '';
                @if (!Model.IsBalanced)
                {
                        <text>differenceHtml = '<br>الفرق: <strong class="text-danger">@Model.Difference.ToString("N2")</strong>';</text>
                }

                balanceResult.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>بيانات الرصيد المحدثة:</strong><br>
                        إجمالي الدائن: <strong>@Model.TotalCredit.ToString("N2")</strong> |
                        إجمالي المدين: <strong>@Model.TotalDebit.ToString("N2")</strong> |
                        حالة الحركة اليومية: <strong class="${statusClass}">${statusText}</strong>
                        ${differenceHtml}
                    </div>
                `;

                // Update the approve button state
                const approveButton = document.getElementById('approveButton');
                if (approveButton) {
                    if (@Model.IsBalanced.ToString().ToLower()) {
                        approveButton.disabled = false;
                    } else {
                        approveButton.disabled = true;
                    }
                }
            }, 1000);
        }

        function showLoading(message = 'جاري المعالجة...') {
            $('body').append(`
                <div class="loading-overlay">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <div class="mt-3 text-primary fw-bold">${message}</div>
                </div>
            `);
        }

        function hideLoading() {
            $('.loading-overlay').remove();
        }

        function showSuccess(message) {
            Swal.fire({
                icon: 'success',
                title: 'نجح',
                text: message,
                confirmButtonText: 'موافق',
                confirmButtonColor: '#1a3a6c'
            });
        }

        function showError(message) {
            Swal.fire({
                icon: 'error',
                title: 'خطأ',
                text: message,
                confirmButtonText: 'موافق',
                confirmButtonColor: '#dc3545'
            });
        }

        function showCredentialError(message) {
            const box = $('#approvalCredentialError');
            box.text(message).removeClass('d-none');
        }

        function clearCredentialError() {
            $('#approvalCredentialError').addClass('d-none').text('');
        }

        $('#notesModal').on('shown.bs.modal', function () {
            $('#managerUsername').focus();
        });

        $('#notesModal').on('hidden.bs.modal', function () {
            $('#approvalNotes').val('');
            $('#managerUsername').val('');
            $('#managerPassword').val('');
            clearCredentialError();
        });

        // Initialize button state
        $(document).ready(function() {
            const approveButton = document.getElementById('approveButton');
            if (approveButton && !@Model.IsBalanced.ToString().ToLower()) {
                approveButton.disabled = true;
            }
        });
    </script>
}

