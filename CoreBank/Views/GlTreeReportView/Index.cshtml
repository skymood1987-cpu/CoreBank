                                }
                                ${account.children && account.children.length > 0 ?
                                    `<div class="children-section">
                                        <h6 class="fw-bold border-bottom pb-2">الحسابات الفرعية (${account.children.length})</h6>
                                        <div class="table-responsive">
                                            <table class="table table-sm">
