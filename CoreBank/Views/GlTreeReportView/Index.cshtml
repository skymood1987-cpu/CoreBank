                                            <label class="fw-bold">عدد الحسابات الفرعية:</label>
                                            <span class="badge bg-warning">${account.childCount || 0}</span>
                                        </div>
                                    </div>
                                </div>
                                ${account.hasTransactions ?
                                    '<div class="alert alert-success"><i class="fas fa-check-circle"></i> يحتوي على معاملات</div>' :
