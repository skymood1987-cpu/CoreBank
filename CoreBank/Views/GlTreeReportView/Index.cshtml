        .banking-card { background: var(--panel) !important; border: 1px solid var(--line) !important; border-radius: 14px !important; box-shadow: 0 12px 24px rgba(10, 37, 74, 0.08) !important; }
        .banking-card .card-header { background: #f8fbff !important; border-bottom: 1px solid var(--line) !important; }
        .transaction-query-section { background: #f8fbff !important; border: 1px solid var(--line) !important; border-radius: 12px !important; }
        .banking-table th { background: #123c78 !important; border-color: #123c78 !important; color: #fff !important; }
        .banking-table td { color: var(--ink) !important; }
        /* Final hard-stop overflow fix for GlTreeReport page only */
        body .shell .content .panel .banking-container {
            inline-size: 100% !important;
            max-inline-size: 100% !important;
            overflow-x: hidden !important;
        }

        body .shell .content .panel .report-card {
            inline-size: 100% !important;
            max-inline-size: 100% !important;
            overflow: hidden !important;
        }

        body .shell .content .panel .report-card > .card-body {
            inline-size: 100% !important;
            max-inline-size: 100% !important;
            overflow-x: hidden !important;
        }

        body .shell .content .panel .report-table-container {
            inline-size: 100% !important;
            max-inline-size: 100% !important;
            overflow-x: auto !important;
            overflow-y: auto !important;
            margin: 0 !important;
            padding-bottom: 2px;
            overscroll-behavior-x: contain;
            overscroll-behavior-y: contain;
            -webkit-overflow-scrolling: touch;
            scrollbar-gutter: stable both-edges;
            max-height: min(52vh, 560px) !important;
        }

        body .shell .content .panel .report-table-container > #reportTable {
            width: max-content !important;
            inline-size: max-content !important;
            min-width: 980px !important;
            max-width: none !important;
            margin: 0 !important;
        }

        body .shell .content .panel .report-table-container > #reportTable th,
        body .shell .content .panel .report-table-container > #reportTable td {
            white-space: nowrap;
        }

        body .shell .content .panel .report-table-container > #reportTable thead th {
            position: sticky;
            top: 0;
            z-index: 2;
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <script>
        $(document).ready(function() {
            // Force branch for all operations
            const currentBranchId = '@ViewBag.userBranchCode';

            // Export report
            $('#exportReport').on('click', function() {
                exportReport();
            });

            // Fix for action buttons - delegate events to work with dynamic content
            $(document).on('click', '.view-details', function() {
                const glId = $(this).data('gl-id');
                viewAccountDetails(glId, $(this).closest('tr'));
            });

            $(document).on('click', '.expand-children', function() {
                const glId = $(this).data('gl-id');
                loadChildren(glId);
            });

            // TRANSACTION SEARCH - UPDATED VERSION WITH GL ACCOUNT SEARCH
            $('#searchTransactions').click(function() {
                console.log('Search button clicked');
                performTransactionSearch();
            });

            // Field visibility for query type - UPDATED
            $('#queryType').change(function() {
                const type = $(this).val();

                // Hide all fields first
                $('#refField, #glField, #startDateField, #endDateField').hide();

                // Show fields based on query type
                if (type === 'ref') {
                    $('#refField').show();
                }
                else if (type === 'gl') {
                    $('#glField').show();
                }
                else if (type === 'gl-date') {
                    $('#glField').show();
                    $('#startDateField').show();
                    $('#endDateField').show();
                }
                else if (type === 'date') {
                    $('#startDateField').show();
                    $('#endDateField').show();
                }
            }).trigger('change');

            function performTransactionSearch() {
                const queryType = $('#queryType').val();
                const transactionRef = $('#transactionRef').val().trim();
                const glId = $('#glIdSearch').val().trim();
                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();
                const branchId = currentBranchId;

                console.log('Search parameters:', {
                    queryType,
                    transactionRef,
                    glId,
                    startDate,
                    endDate
                });

                // Validation based on query type
                if (queryType === 'ref' && !transactionRef) {
                    alert('يرجى إدخال الرقم المرجعي');
                    return;
                }

                if (queryType === 'gl' && !glId) {
                    alert('يرجى إدخال رقم الحساب');
                    return;
                }

                if (queryType === 'date' && (!startDate || !endDate)) {
                    alert('يرجى إدخال التاريخ');
                    return;
                }

                if (queryType === 'gl-date' && (!glId || !startDate || !endDate)) {
                    alert('يرجى إدخال رقم الحساب والتاريخ');
                    return;
                }

                // Show loading
                showLoading();

                // Prepare data
                const requestData = {
                    branchId: branchId,
                    transactionRef: transactionRef,
                    glId: glId, // Add GL ID to request
                    startDate: startDate,
                    endDate: endDate
                };

                // Determine API URL based on query type
                let apiUrl;
                switch(queryType) {
                    case 'ref':
                        apiUrl = '/api/GlTreeReport/transactions/by-ref-branch';
                        break;
                    case 'date':
                        apiUrl = '/api/GlTreeReport/transactions/by-date-branch';
                        break;
                    case 'gl':
                        apiUrl = '/api/GlTreeReport/transactions/by-gl-branch';
                        break;
                    case 'gl-date':
                        apiUrl = '/api/GlTreeReport/transactions/by-gl-date-branch';
                        break;
                    default:
                        apiUrl = '/api/GlTreeReport/transactions/by-ref-branch';
                }

                console.log('Making request to:', apiUrl, 'with data:', requestData);

                // Make request
                $.ajax({
                    url: apiUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function(transactions) {
                        console.log('Received transactions:', transactions);
                        if (transactions && Array.isArray(transactions)) {
                            // Check if this is a GL account query
                            const isGlQuery = queryType === 'gl' || queryType === 'gl-date';

                            if (isGlQuery && glId) {
                                // For GL account queries, fetch account cumulative data
                                fetchAccountCumulativeData(glId, branchId, function(accountData) {
                                    if (accountData) {
                                        showBankStyleResultsWithAccountData(transactions, queryType, requestData, glId, accountData);
                                    } else {
                                        // Fallback to basic results
                                        showBankStyleResults(transactions, queryType, requestData, glId);
                                    }
                                });
                            } else {
                                // For non-GL queries, show basic results
                                showBankStyleResults(transactions, queryType, requestData, null);
                            }
                        } else {
                            console.error('Invalid response format:', transactions);
                            showError('استجابة غير صالحة من الخادم');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('AJAX Error:', status, error, xhr);
                        let errorMsg = 'خطأ في الاتصال بالخادم';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.statusText) {
                            errorMsg = xhr.statusText;
                        }
                        showError(errorMsg);
                    },
                    complete: function() {
                        hideLoading();
                    }
                });
            }

            function getRowAccountSnapshot($row) {
                if (!$row || !$row.length) {
                    return null;
                }

                const cells = $row.children('td');
                const readAmount = index => {
                    const raw = $(cells[index]).text().trim().replace(/,/g, '');
                    const value = Number(raw);
                    return Number.isFinite(value) ? value : 0;
                };

                return {
                    glId: $(cells[0]).text().trim(),
                    glName: $(cells[1]).text().trim(),
                    level: $(cells[2]).text().trim(),
                    debit: readAmount(3),
                    credit: readAmount(4),
                    balance: readAmount(5),
                    ownBalance: readAmount(6)
                };
            }

            function normalizeAccountDetails(data, rowSnapshot) {
                const account = data || {};
                const row = rowSnapshot || {};
                const pick = (...values) => values.find(value => value !== undefined && value !== null && value !== '');

                return {
                    glId: pick(account.glId, account.GlId, row.glId),
                    glName: pick(account.glName, account.GlName, row.glName),
                    level: pick(account.level, account.Level, row.level),
                    balance: Number(pick(row.balance, account.balance, account.Balance, 0)) || 0,
                    ownBalance: Number(pick(row.ownBalance, account.ownBalance, account.OwnBalance, 0)) || 0,
                    debit: Number(pick(row.debit, account.debit, account.Debit, 0)) || 0,
                    credit: Number(pick(row.credit, account.credit, account.Credit, 0)) || 0,
                    ownDebit: Number(pick(account.ownDebit, account.OwnDebit, 0)) || 0,
                    ownCredit: Number(pick(account.ownCredit, account.OwnCredit, 0)) || 0,
                    parentGlId: pick(account.parentGlId, account.ParentGlId),
                    childCount: Number(pick(account.childCount, account.ChildCount, 0)) || 0,
                    hasTransactions: Boolean(pick(account.hasTransactions, account.HasTransactions, false)),
                    children: pick(account.children, account.Children, [])
                };
            }

            // NEW FUNCTION: Fetch account cumulative data from main table API
            function fetchAccountCumulativeData(glId, branchId, callback) {
                $.ajax({
                    url: `/api/GlTreeReport/account/${glId}/details?branchId=${branchId}`,
                    type: 'GET',
                    success: function(accountData) {
                        console.log('Account cumulative data fetched:', accountData);
                        callback(normalizeAccountDetails(accountData));
                    },
                    error: function(xhr) {
                        console.error('Error fetching account data:', xhr);
                        callback(null);
                    }
                });
            }

            // NEW FUNCTION: Show results with account cumulative data
            function showBankStyleResultsWithAccountData(transactions, queryType, requestData, glId, accountData) {
                console.log('Displaying results with account cumulative data');

                // Get GL account name from first transaction or account data
                const glName = transactions[0]?.glName || accountData?.glName || 'غير معروف';

                // Get cumulative data from accountData (same as main table)
                const cumulativeDebit = accountData.debit || accountData.ownDebit || 0;
                const cumulativeCredit = accountData.credit || accountData.ownCredit || 0;
                const cumulativeBalance = accountData.balance || accountData.ownBalance || 0;

                // Calculate totals from individual transactions
                let totalTransactionDebit = 0;
                let totalTransactionCredit = 0;
                let totalTransactionBalance = 0;

                transactions.forEach(trans => {
                    const debit = trans.debitAccount || trans.debit || 0;
                    const credit = trans.creditAccount || trans.credit || 0;
                    totalTransactionDebit += debit;
                    totalTransactionCredit += credit;
                    totalTransactionBalance += (credit - debit);
                });

                const totalTransactions = transactions.length;

                let html = '<div class="p-3">';

                // Account Summary Header with CUMULATIVE DATA
                html += `
                    <!-- Account Summary Header -->
                    <div class="account-summary-card mb-4 p-3 border rounded" style="background-color: #f8f9fa;">
                        <div class="row">
                            <div class="col-md-3">
                                <h6 class="mb-1"><i class="fas fa-file-invoice-dollar me-2"></i>بيانات الحساب التراكمية</h6>
                                <div class="small">
                                    <div><strong>رقم الحساب:</strong> ${glId}</div>
                                    <div><strong>اسم الحساب:</strong> ${glName}</div>
                                    <div><strong>عدد المعاملات:</strong> ${totalTransactions}</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <div class="small text-muted">المدين التراكمي</div>
                                    <div class="h5 text-danger fw-bold">${formatCurrency(cumulativeDebit)}</div>
                                    <small class="text-muted">(بما في ذلك الحسابات الفرعية)</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <div class="small text-muted">الدائن التراكمي</div>
                                    <div class="h5 text-success fw-bold">${formatCurrency(cumulativeCredit)}</div>
                                    <small class="text-muted">(بما في ذلك الحسابات الفرعية)</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <div class="small text-muted">الرصيد التراكمي</div>
                                    <div class="h4 fw-bold ${cumulativeBalance >= 0 ? 'text-success' : 'text-danger'}">
                                        ${formatCurrency(cumulativeBalance)}
                                    </div>
                                    <small class="text-muted">(الدائن - المدين)</small>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-12">
                                <div class="small text-muted border-top pt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    <strong>توضيح:</strong> البيانات التراكمية أعلاه تطابق الجدول الرئيسي وتشمل جميع الحسابات الفرعية
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                // Rest of the display code...
                html += getTransactionsTableHtml(transactions, queryType, requestData,
                    totalTransactionDebit, totalTransactionCredit, totalTransactionBalance,
                    cumulativeDebit, cumulativeCredit, cumulativeBalance);

                html += '</div>';

                $('#transactionResultsContent').html(html);
                $('#transactionResultsModal').modal('show');
            }

            // NEW FUNCTION: Get transactions table HTML
            function getTransactionsTableHtml(transactions, queryType, requestData,
                totalTransactionDebit, totalTransactionCredit, totalTransactionBalance,
                cumulativeDebit, cumulativeCredit, cumulativeBalance) {

                const totalTransactions = transactions.length;
                const searchCriteria = getSearchCriteriaText(queryType, requestData);

                return `
                    <!-- Simple Header Section -->
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <div>
                            <h5 class="mb-1">نتائج استعلام المعاملات</h5>
                            <p class="text-muted mb-0 small">
                                ${searchCriteria}
                            </p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary">${totalTransactions} معاملة</span>
                        </div>
                    </div>

                    <!-- Transactions Table -->
                    <div class="border">
                        <div class="bg-light p-2 border-bottom">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h6 class="mb-0">تفاصيل المعاملات الفردية</h6>
                                    <small class="text-muted">(هذا الجدول يظهر المعاملات الفردية فقط)</small>
                                </div>
                                <div class="col-md-6 text-end">
                                    <small class="text-muted">الفرع ${currentBranchId}</small>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive" style="max-height: 500px;">
                            <table class="table table-bordered table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th width="120" class="text-center">الرقم المرجعي</th>
                                        <th width="100" class="text-center">التاريخ</th>
                                        <th width="100" class="text-center">الحساب</th>
                                        <th class="text-center">اسم الحساب</th>
                                        <th width="120" class="text-center">المدين</th>
                                        <th width="120" class="text-center">الدائن</th>
                                        <th width="120" class="text-center">صافي المعاملة</th>
                                        <th class="text-center">الوصف</th>
                                        <th width="80" class="text-center">الفرع</th>
                                        <th width="100" class="text-center">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${transactions.map((trans, index) => {
                                        const debit = trans.debitAccount || trans.debit || 0;
                                        const credit = trans.creditAccount || trans.credit || 0;
                                        const transactionBalance = credit - debit;
                                        const date = trans.date ? new Date(trans.date).toLocaleDateString('ar-EG') : 'N/A';

                                        return `
                                            <tr class="${index % 2 === 0 ? 'even-row' : 'odd-row'}">
                                                <td class="fw-bold text-center">${trans.transactionRef || 'N/A'}</td>
                                                <td class="text-center">${date}</td>
                                                <td class="fw-bold text-center">${trans.glId || 'N/A'}</td>
                                                <td class="text-center">${trans.glName || 'N/A'}</td>
                                                <td class="text-end fw-bold ${debit > 0 ? 'text-danger' : 'text-muted'}">
                                                    ${debit > 0 ? formatCurrency(debit) : '0.00'}
                                                </td>
                                                <td class="text-end fw-bold ${credit > 0 ? 'text-success' : 'text-muted'}">
                                                    ${credit > 0 ? formatCurrency(credit) : '0.00'}
                                                </td>
                                                <td class="text-end fw-bold ${transactionBalance >= 0 ? 'text-success' : 'text-danger'}">
                                                    ${formatCurrency(transactionBalance)}
                                                </td>
                                                <td class="text-center">
                                                    <span title="${trans.descriptionEn || trans.descriptionAr || ''}">
                                                        ${trans.descriptionAr || trans.descriptionEn || 'N/A'}
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">${trans.branchId || 'N/A'}</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-success">${trans.status || 'مكتمل'}</span>
                                                </td>
                                            </tr>
                                        `;
                                    }).join('')}
                                </tbody>
                                <tfoot class="table-secondary">
                                    <!-- Individual Transactions Totals -->
                                    <tr>
                                        <th colspan="4" class="text-center">مجموع المعاملات الموجودة</th>
                                        <th class="text-end">${formatCurrency(totalTransactionDebit)}</th>
                                        <th class="text-end">${formatCurrency(totalTransactionCredit)}</th>
                                        <th class="text-end ${totalTransactionBalance >= 0 ? 'text-success' : 'text-danger'}">
                                            ${formatCurrency(totalTransactionBalance)}
                                        </th>
                                        <th colspan="3" class="text-center"></th>
                                    </tr>
                                    <!-- Cumulative Account Totals (From Main Table) -->
                                    <tr style="background-color: #e3f2fd;">
                                        <th colspan="4" class="text-center">المجاميع التراكمية للحساب (مثل الجدول الرئيسي)</th>
                                        <th class="text-end">${formatCurrency(cumulativeDebit)}</th>
                                        <th class="text-end">${formatCurrency(cumulativeCredit)}</th>
                                        <th class="text-end ${cumulativeBalance >= 0 ? 'text-success' : 'text-danger'}">
                                            ${formatCurrency(cumulativeBalance)}
                                        </th>
                                        <th colspan="3" class="text-center">
                                            <small class="text-muted">يشمل الحسابات الفرعية</small>
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Summary -->
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <h6><i class="fas fa-info-circle me-2"></i>توضيح:</h6>
                                <ul class="mb-0">
                                    <li>الجدول أعلاه يظهر <strong>المعاملات الفردية</strong> فقط التي تطابق معايير البحث</li>
                                    <li>المجاميع التراكمية في أسفل الجدول تظهر <strong>إجمالي الحساب بما في ذلك الحسابات الفرعية</strong> (مثل الجدول الرئيسي)</li>
                                    <li>الفرق بين معاملات البحث والإجمالي التراكمي بسبب وجود حسابات فرعية</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Original function for basic results (non-GL queries)
            function showBankStyleResults(transactions, queryType, requestData, glId) {
                console.log('Displaying basic results for', transactions.length, 'transactions');

                let html = '<div class="p-3">';

                if (!transactions || transactions.length === 0) {
                    html += `
                        <div class="text-center py-4">
                            <h5 class="text-muted">لا توجد نتائج للبحث</h5>
                            <p class="text-muted">لم يتم العثور على معاملات تطابق معايير البحث</p>
                            <div class="mt-2">
                                <small class="text-muted">${getSearchCriteriaText(queryType, requestData)}</small>
                            </div>
                        </div>
                    `;
                } else {
                    // Calculate totals for ALL columns
                    const totalDebit = transactions.reduce((sum, t) => sum + (t.debitAccount || t.debit || 0), 0);
                    const totalCredit = transactions.reduce((sum, t) => sum + (t.creditAccount || t.credit || 0), 0);
                    const totalTransactions = transactions.length;
                    const totalBalance = totalCredit - totalDebit;

                    html += `
                        <!-- Simple Header Section -->
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                            <div>
                                <h5 class="mb-1">نتائج استعلام المعاملات</h5>
                                <p class="text-muted mb-0 small">
                                    ${getSearchCriteriaText(queryType, requestData)}
                                </p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary">${totalTransactions} معاملة</span>
                            </div>
                        </div>

                        <!-- Transactions Table -->
                        <div class="border">
                            <div class="bg-light p-2 border-bottom">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <h6 class="mb-0">تفاصيل المعاملات</h6>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <small class="text-muted">الفرع ${currentBranchId}</small>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive" style="max-height: 500px;">
                                <table class="table table-bordered table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="120" class="text-center">الرقم المرجعي</th>
                                            <th width="100" class="text-center">التاريخ</th>
                                            <th width="100" class="text-center">الحساب</th>
                                            <th class="text-center">اسم الحساب</th>
                                            <th width="120" class="text-center">المدين</th>
                                            <th width="120" class="text-center">الدائن</th>
                                            <th width="120" class="text-center">صافي المعاملة</th>
                                            <th class="text-center">الوصف</th>
                                            <th width="80" class="text-center">الفرع</th>
                                            <th width="100" class="text-center">الحالة</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                    `;

                    transactions.forEach((trans, index) => {
                        const debit = trans.debitAccount || trans.debit || 0;
                        const credit = trans.creditAccount || trans.credit || 0;
                        const transactionBalance = credit - debit;
                        const date = trans.date ? new Date(trans.date).toLocaleDateString('ar-EG') : 'N/A';

                        html += `
                            <tr class="${index % 2 === 0 ? 'even-row' : 'odd-row'}">
                                <td class="fw-bold text-center">${trans.transactionRef || 'N/A'}</td>
                                <td class="text-center">${date}</td>
                                <td class="fw-bold text-center">${trans.glId || 'N/A'}</td>
                                <td class="text-center">${trans.glName || 'N/A'}</td>
                                <td class="text-end fw-bold ${debit > 0 ? 'text-danger' : 'text-muted'}">
                                    ${debit > 0 ? formatCurrency(debit) : '0.00'}
                                </td>
                                <td class="text-end fw-bold ${credit > 0 ? 'text-success' : 'text-muted'}">
                                    ${credit > 0 ? formatCurrency(credit) : '0.00'}
                                </td>
                                <td class="text-end fw-bold ${transactionBalance >= 0 ? 'text-success' : 'text-danger'}">
                                    ${formatCurrency(transactionBalance)}
                                </td>
                                <td class="text-center">
                                    <span title="${trans.descriptionEn || trans.descriptionAr || ''}">
