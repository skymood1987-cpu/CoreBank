                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">${trans.branchId || 'N/A'}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success">${trans.status || 'مكتمل'}</span>
                                </td>
                            </tr>
                        `;
                    });

                    html += `
                                    </tbody>
                                    <tfoot class="table-secondary">
                                        <tr>
                                            <th colspan="4" class="text-center">المجاميع النهائية</th>
                                            <th class="text-end">${formatCurrency(totalDebit)}</th>
                                            <th class="text-end">${formatCurrency(totalCredit)}</th>
                                            <th class="text-end ${totalBalance >= 0 ? 'text-success' : 'text-danger'}">
                                                ${formatCurrency(totalBalance)}
                                            </th>
                                            <th colspan="3" class="text-center"></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <!-- Simple Summary Info -->
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="border p-2">
                                    <h6>ملخص البحث</h6>
                                    <div class="row">
                                        <div class="col-6">
                                            <small class="text-muted">عدد المعاملات:</small>
                                            <div class="fw-bold">${totalTransactions}</div>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">الفترة:</small>
                                            <div class="fw-bold">${requestData.startDate || 'N/A'} إلى ${requestData.endDate || 'N/A'}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border p-2">
                                    <h6>التحليل المالي</h6>
                                    <div class="row">
                                        <div class="col-6">
                                            <small class="text-muted">نسبة المدين:</small>
                                            <div class="fw-bold text-danger">${calculatePercentage(totalDebit, totalDebit + totalCredit)}%</div>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">نسبة الدائن:</small>
                                            <div class="fw-bold text-success">${calculatePercentage(totalCredit, totalDebit + totalCredit)}%</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }

                html += '</div>';

                console.log('Setting HTML content');
                $('#transactionResultsContent').html(html);
                $('#transactionResultsModal').modal('show');
            }

            function getSearchCriteriaText(queryType, requestData) {
                if (queryType === 'ref') {
                    return `بحث بالرقم المرجعي: ${requestData.transactionRef}`;
                } else if (queryType === 'gl') {
                    return `بحث برقم الحساب: ${requestData.glId}`;
                } else if (queryType === 'gl-date') {
                    return `بحث برقم الحساب: ${requestData.glId} والفترة: ${requestData.startDate} إلى ${requestData.endDate}`;
                } else {
                    return `بحث بالفترة: ${requestData.startDate} إلى ${requestData.endDate}`;
                }
            }

            function formatCurrency(amount) {
                return parseFloat(amount).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
            }

            function calculatePercentage(part, total) {
                if (total === 0) return '0.0';
                return ((part / total) * 100).toFixed(1);
            }

            function showError(message) {
                const html = `
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                        <h4 class="text-danger">حدث خطأ</h4>
                        <p class="text-muted">${message}</p>
                        <button class="btn btn-primary mt-3" onclick="$('#transactionResultsModal').modal('hide')">
                            <i class="fas fa-times me-1"></i>إغلاق
                        </button>
                    </div>
                `;
                $('#transactionResultsContent').html(html);
                $('#transactionResultsModal').modal('show');
            }

            function exportReport() {
                console.log('Exporting for branch:', currentBranchId);

                // Show loading
                showLoading();

                // Use the branch-specific API endpoint
                $.ajax({
                    url: `/api/GlTreeReport/branch/${currentBranchId}/flat`,
                    type: 'GET',
                    success: function(response) {
                        console.log('Export response:', response);
                        if (response && response.length > 0) {
                            // Filter to get only Main Categories (Depth = 0)
                            const mainCategories = response.filter(item => item.depth === 0);

                            if (mainCategories.length > 0) {
                                const asOfDate = new Date().toISOString().split('T')[0];
                                generateExcelFile(mainCategories, currentBranchId, asOfDate);
                            } else {
                                alert('لا توجد حسابات رئيسية للتصدير');
                            }
                        } else {
                            alert('لا توجد بيانات للتصدير للفرع المحدد');
                        }
                    },
                    error: function(xhr) {
                        console.error('Error exporting report:', xhr);
                        let errorMsg = 'حدث خطأ أثناء تصدير التقرير';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg += ': ' + xhr.responseJSON.message;
                        } else if (xhr.statusText) {
                            errorMsg += ': ' + xhr.statusText;
                        }
                        alert(errorMsg);
                    },
                    complete: function() {
                        hideLoading();
                    }
                });
            }

            function generateExcelFile(data, branchId, asOfDate) {
                // Show loading indicator
                showLoading();

                try {
                    // Check if ExcelJS is available
                    if (typeof ExcelJS === 'undefined') {
                        alert('مكتبة ExcelJS غير محملة. يرجى التحقق من الاتصال بالإنترنت');
                        return;
                    }

                    console.log('Generating Excel with ExcelJS from data:', data);

                    // Filter for Main Categories ONLY (Depth = 0)
                    const mainCategories = data.filter(item => item.depth === 0);
                    console.log('Main Categories found:', mainCategories.length, 'out of', data.length, 'total accounts');

                    // Create workbook with ExcelJS
                    const workbook = new ExcelJS.Workbook();
                    workbook.creator = 'Banking System';
                    workbook.lastModifiedBy = 'Banking System';
                    workbook.created = new Date();
                    workbook.modified = new Date();

                    // Add worksheet with RTL support
                    const worksheet = workbook.addWorksheet('تقرير حسابات رئيسية', {
                        pageSetup: {
                            paperSize: 9,
                            orientation: 'landscape',
                            showGridLines: false
                        },
                        views: [
                            { rightToLeft: true } // RTL support
                        ]
                    });

                    // Define columns - ONLY MAIN CATEGORIES with requested columns
                    worksheet.columns = [
                        { header: 'رقم الدليل', key: 'glId', width: 20 },
                        { header: 'اسم الاستاذ العام', key: 'glName', width: 40 },
                        { header: 'رصيد المدين', key: 'debitBalance', width: 15 },
                        { header: 'رصيد الدائن', key: 'creditBalance', width: 15 },
                        { header: 'الرصيد الإجمالي', key: 'totalBalance', width: 15 }
                    ];

                    // Add header row with DARK BLUE color
                    const headerRow = worksheet.getRow(1);
                    headerRow.height = 25;
                    headerRow.eachCell((cell, colNumber) => {
                        cell.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: { argb: 'FF1a3a6c' } // Dark Blue (same as your website theme)
                        };
                        cell.font = {
                            bold: true,
                            color: { argb: 'FFFFFFFF' }, // White text
                            size: 12
                        };
                        cell.border = {
                            top: { style: 'thin', color: { argb: 'FFFFFFFF' } },
                            left: { style: 'thin', color: { argb: 'FFFFFFFF' } },
                            bottom: { style: 'thin', color: { argb: 'FFFFFFFF' } },
                            right: { style: 'thin', color: { argb: 'FFFFFFFF' } }
                        };
                        cell.alignment = {
                            vertical: 'middle',
                            horizontal: 'center',
                            wrapText: true
                        };
                    });

                    let totalDebit = 0;
                    let totalCredit = 0;
                    let totalBalance = 0;

                    // Add data rows for MAIN CATEGORIES ONLY
                    mainCategories.forEach((account, index) => {
                        const debitBalance = account.debit || 0;
                        const creditBalance = account.credit || 0;
                        const totalBalanceValue = account.balance || 0;

                        totalDebit += debitBalance;
                        totalCredit += creditBalance;
                        totalBalance += totalBalanceValue;

                        const rowData = {
                            glId: account.glId || '',
                            glName: account.glName || '',
                            debitBalance: debitBalance,
                            creditBalance: creditBalance,
                            totalBalance: totalBalanceValue
                        };

                        const row = worksheet.addRow(rowData);
                        row.height = 22; // Set row height

                        // Apply styling to each cell in the row
                        row.eachCell((cell, colNumber) => {
                            // Default borders for all cells
                            cell.border = {
                                top: { style: 'thin', color: { argb: 'FF000000' } },
                                left: { style: 'thin', color: { argb: 'FF000000' } },
                                bottom: { style: 'thin', color: { argb: 'FF000000' } },
                                right: { style: 'thin', color: { argb: 'FF000000' } }
                            };

                            // Right align for all cells except GL ID (center it)
                            if (colNumber === 1) { // GL ID column
                                cell.alignment = {
                                    vertical: 'middle',
                                    horizontal: 'center',
                                    wrapText: true
                                };
                            } else { // Other columns
                                cell.alignment = {
                                    vertical: 'middle',
                                    horizontal: 'right',
                                    wrapText: true
                                };
                            }

                            // Apply alternating row colors for better readability
                            let backgroundColor = { argb: 'FFFFFFFF' }; // Default white

                            if (index % 2 === 0) {
                                // Even rows: Light gray background
                                backgroundColor = { argb: 'FFF8F9FA' };
                            } else {
                                // Odd rows: Very light blue background
                                backgroundColor = { argb: 'FFF0F8FF' };
                            }

                            // Apply the background color to ALL cells in the row
                            cell.fill = {
                                type: 'pattern',
                                pattern: 'solid',
                                fgColor: backgroundColor
                            };

                            // Bold font for GL ID and Name
                            if (colNumber === 1 || colNumber === 2) {
                                cell.font = { bold: true };
                            }

                            // Number formatting for balance columns (columns 3-5)
                            if (colNumber >= 3 && colNumber <= 5) {
                                cell.numFmt = '#,##0.00';

                                // Color coding for debit column (column 3)
                                if (colNumber === 3 && debitBalance > 0) {
                                    cell.font = {
                                        ...cell.font,
                                        color: { argb: 'FF8B0000' } // Dark Red for debit
                                    };
                                }

                                // Color coding for credit column (column 4)
                                if (colNumber === 4 && creditBalance > 0) {
                                    cell.font = {
                                        ...cell.font,
                                        color: { argb: 'FF006400' } // Dark Green for credit
                                    };
                                }

                                // Color coding for total balance column (column 5)
                                if (colNumber === 5) {
                                    if (totalBalanceValue >= 0) {
                                        cell.font = {
                                            ...cell.font,
                                            color: { argb: 'FF006400' } // Dark Green for positive
                                        };
                                    } else {
                                        cell.font = {
                                            ...cell.font,
                                            color: { argb: 'FF8B0000' } // Dark Red for negative
                                        };
                                    }
                                }
                            }
                        });
                    });

                    // Add separator row
                    worksheet.addRow([]);

                    // Add TOTALS row with DARK BLUE background
                    const totalsRow = worksheet.addRow({
                        glId: 'المجموع',
                        glName: '',
                        debitBalance: totalDebit,
                        creditBalance: totalCredit,
                        totalBalance: totalBalance
                    });

                    // Style totals row - DARK BLUE background
                    totalsRow.height = 25;
                    totalsRow.eachCell((cell, colNumber) => {
                        // Apply dark blue background to ALL cells in totals row
                        cell.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: { argb: 'FF1a3a6c' } // Dark Blue
                        };

                        // White bold text for all cells
                        cell.font = {
                            bold: true,
                            color: { argb: 'FFFFFFFF' } // White text
                        };

                        // Borders for totals row
                        cell.border = {
                            top: { style: 'medium', color: { argb: 'FFFFFFFF' } },
                            left: { style: 'thin', color: { argb: 'FFFFFFFF' } },
                            bottom: { style: 'medium', color: { argb: 'FFFFFFFF' } },
                            right: { style: 'thin', color: { argb: 'FFFFFFFF' } }
                        };

                        // Center alignment for first column, right alignment for others
                        if (colNumber === 1) {
                            cell.alignment = {
                                vertical: 'middle',
                                horizontal: 'center',
                                wrapText: true
                            };
                        } else {
                            cell.alignment = {
                                vertical: 'middle',
                                horizontal: 'right',
                                wrapText: true
                            };
                        }

                        // Number formatting for balance columns (columns 3-5)
                        if (colNumber >= 3 && colNumber <= 5) {
                            cell.numFmt = '#,##0.00';

                            // Color coding for totals columns
                            if (colNumber === 3) { // Debit total
                                cell.font.color = { argb: 'FFFFB6C1' }; // Light Red
                            } else if (colNumber === 4) { // Credit total
                                cell.font.color = { argb: 'FF90EE90' }; // Light Green
                            } else if (colNumber === 5) { // Balance total
                                if (totalBalance >= 0) {
                                    cell.font.color = { argb: 'FF90EE90' }; // Light Green
                                } else {
                                    cell.font.color = { argb: 'FFFFB6C1' }; // Light Red
                                }
                            }
                        }
                    });

                    // Add summary info row (optional)
                    const summaryRow = worksheet.addRow({
                        glId: 'ملخص',
                        glName: `عدد الحسابات الرئيسية: ${mainCategories.length}`,
                        debitBalance: '',
                        creditBalance: '',
                        totalBalance: `تاريخ التقرير: ${asOfDate}`
                    });

                    // Merge cells for the summary
                    worksheet.mergeCells(`A${summaryRow.number}:E${summaryRow.number}`);

                    // Style summary row
                    summaryRow.eachCell((cell, colNumber) => {
                        cell.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: { argb: 'FFF0F0F0' } // Light Gray
                        };
                        cell.font = {
                            italic: true,
                            color: { argb: 'FF666666' }
                        };
                        cell.alignment = {
                            vertical: 'middle',
                            horizontal: 'center'
                        };
                    });

                    // Freeze the header row
                    worksheet.views = [
                        { state: 'frozen', xSplit: 0, ySplit: 1, rightToLeft: true }
                    ];

                    // Set column widths for better formatting
                    worksheet.columns.forEach(column => {
                        if (column.key === 'glId') column.width = 20;
                        if (column.key === 'glName') column.width = 40;
                        if (column.key === 'debitBalance') column.width = 15;
                        if (column.key === 'creditBalance') column.width = 15;
                        if (column.key === 'totalBalance') column.width = 15;
                    });

                    // Generate file name
                    const fileName = `تقرير_الحسابات_الرئيسية_الفرع_${branchId}_${asOfDate}.xlsx`;

                    // Write to file and download
                    workbook.xlsx.writeBuffer().then(buffer => {
                        saveAs(new Blob([buffer]), fileName);
                        hideLoading();

                        // Show success message
                        // alert(`تم تصدير ${mainCategories.length} حساب رئيسي بنجاح إلى ملف Excel`);
                    }).catch(error => {
                        console.error('Error writing Excel file:', error);
                        alert('حدث خطأ أثناء إنشاء ملف Excel');
                        hideLoading();
                    });

                } catch (error) {
                    console.error('Error generating Excel file:', error);
                    alert('حدث خطأ أثناء إنشاء ملف Excel: ' + error.message);
                    hideLoading();
                }
            }

