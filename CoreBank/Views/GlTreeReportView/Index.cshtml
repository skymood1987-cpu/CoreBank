@model IEnumerable<MinCoreBank.Models.Dtos.GlTreeDisplayDto>

@{
    ViewData["Title"] = "تقارير حسابات الاستاذ العام";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Handle null model
    var modelData = Model ?? new List<MinCoreBank.Models.Dtos.GlTreeDisplayDto>();

    // CORRECTED: Calculate totals from MAIN CATEGORIES only (Depth = 0)
    decimal totalBalance = 0;
    decimal totalAvailableBalance = 0;
    decimal totalDebit = 0;
    decimal totalCredit = 0;
    int leafNodeCount = 0;
    int hasChildrenCount = 0;
    int totalRecords = 0;
    var userBranchCode = ViewBag.UserBranchCode as string;

    if (modelData != null)
    {
        totalRecords = modelData.Count();

        foreach (var item in modelData)
        {
            // COUNT ALL accounts for statistics
            if (item.IsLeafNode)
                leafNodeCount++;

            if (item.HasChildren)
                hasChildrenCount++;

            // CORRECTED: Only add to totals if it's a MAIN CATEGORY (Depth = 0)
            // This prevents double/triple counting of child balances
            if (item.Depth == 0)
            {
                totalBalance += item.Balance;           // Cumulative balance of main category
                totalAvailableBalance += item.AvailableBalance;  // Cumulative available balance
                totalDebit += item.Debit;               // Cumulative debit of main category
                totalCredit += item.Credit;             // Cumulative credit of main category
            }
        }
    }
}

<div class="banking-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-sitemap fa-lg me-2"></i>@ViewData["Title"]
        </h1>
        <div class="btn-group">
            <button type="button" class="btn btn-primary" id="exportReport">
                <i class="fas fa-file-export me-2"></i>تصدير التقرير (Excel)
            </button>
        </div>
    </div>

    <!-- Transaction Query Section - UPDATED -->
    <div class="row mt-3 report-query-row">
        <div class="col-12">
            <div class="transaction-query-section p-3 border rounded bg-light">
                <h6 class="mb-3"><i class="fas fa-search-dollar me-2"></i>استعلام المعاملات</h6>
                <div class="row g-2 align-items-end">
                    <!-- Reference Number -->
                    <div class="col-md-3" id="refField">
                        <label class="form-label small mb-1">رقم المرجع</label>
                        <input type="text" class="form-control form-control-sm" id="transactionRef" placeholder="أدخل الرقم المرجعي...">
                    </div>

                    <!-- GL Account Number - NEW -->
                    <div class="col-md-3" id="glField" style="display: none;">
                        <label class="form-label small mb-1">رقم الحساب</label>
                        <input type="text" class="form-control form-control-sm" id="glIdSearch" placeholder="أدخل رقم الحساب...">
                    </div>

                    <!-- Start Date -->
                    <div class="col-md-2" id="startDateField" style="display: none;">
                        <label class="form-label small mb-1">من تاريخ</label>
                        <input type="date" class="form-control form-control-sm" id="startDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>

                    <!-- End Date -->
                    <div class="col-md-2" id="endDateField" style="display: none;">
                        <label class="form-label small mb-1">إلى تاريخ</label>
                        <input type="date" class="form-control form-control-sm" id="endDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>

                    <!-- Query Type -->
                    <div class="col-md-2">
                        <label class="form-label small mb-1">نوع الاستعلام</label>
                        <select class="form-select form-select-sm" id="queryType">
                            <option value="ref">بالرقم المرجعي</option>
                            <option value="date">بالتاريخ</option>
                            <option value="gl">برقم الحساب</option>
                            <option value="gl-date">برقم الحساب والتاريخ</option>
                        </select>
                    </div>

                    <!-- Search Button -->
                    <div class="col-md-3">
                        <div class="btn-group w-100">
                            <button class="btn btn-primary btn-sm" id="searchTransactions">
                                <i class="fas fa-search me-1"></i>بحث
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Report Data -->
<div class="banking-card report-card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="mb-0 report-data-title">
                    <i class="fas fa-table me-2"></i>بيانات التقرير - الفرع @ViewBag.userBranchCode
                    <span class="badge bg-secondary ms-2 report-data-badge">@totalRecords سجل</span>
                </h5>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive report-table-container">
            <table class="table table-bordered banking-table" id="reportTable">
                <thead class="table-dark">
                    <tr>
                        <th width="120">رقم الدليل</th>
                        <th>اسم الحساب</th>
                        <th>المستوى</th>
                        <th width="120" class="text-end">الرصيد المدين</th>
                        <th width="120" class="text-end">الرصيد الدائن</th>
                        <th width="150" class="text-end">الرصيد الإجمالي</th>
                        <th width="150" class="text-end">الرصيد الخاص</th>
                        <th width="120">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (modelData != null)
                    {
                        foreach (var account in modelData)
                        {
                            <tr data-depth="@account.Depth" data-has-children="@account.HasChildren.ToString().ToLower()"
                                data-gl-id="@account.GlId" data-parent-id="@account.ParentGlId"
                                class="level-@account.Depth">
                                <td class="fw-bold">
                                    <span class="account-indent" style="padding-left: @(account.Depth * 20)px">
                                        @if (account.HasChildren)
                                        {
                                            <i class="fas fa-folder text-warning me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-file-invoice-dollar text-success me-1"></i>
                                        }
                                        @account.GlId
                                    </span>
                                </td>
                                <td class="account-name">@account.GlName</td>
                                <td>
                                    <span class="badge bg-info">@account.LevelName</span>
                                </td>
                                <!-- NEW: Debit Column -->
                                <td class="text-end fw-bold text-danger">
                                    @account.Debit.ToString("N2")
                                </td>
                                <!-- NEW: Credit Column -->
                                <td class="text-end fw-bold text-success">
                                    @account.Credit.ToString("N2")
                                </td>
                                <!-- Existing Balance Columns -->
                                <td class="text-end fw-bold @(account.Balance >= 0 ? "text-success" : "text-danger")">
                                    @account.Balance.ToString("N2")
                                </td>

                                <td class="text-end @(account.OwnBalance >= 0 ? "text-success" : "text-danger")">
                                    @account.OwnBalance.ToString("N2")
                                </td>

                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info view-details" data-gl-id="@account.GlId" title="عرض التفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        @if (account.HasChildren)
                                        {
                                            <button class="btn btn-outline-secondary expand-children" data-gl-id="@account.GlId" title="عرض الحسابات الفرعية">
                                                <i class="fas fa-chevron-down"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.NoSearchResults == true)
        {
            <div class="text-center py-5">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <p class="text-muted mb-1">لا توجد نتائج</p>
                <small class="text-muted">لم يتم العثور على رقم الحساب: @ViewBag.AccountNumberSearch</small>
            </div>
        }
        else if (modelData == null || !modelData.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-sitemap fa-3x text-muted mb-3"></i>
                <p class="text-muted">لا توجد بيانات للتقرير المحدد</p>
            </div>
        }
    </div>
</div>
</div>

<!-- Transactions Modal -->
<div class="modal fade" id="transactionsModal" tabindex="-1" aria-labelledby="transactionsModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title fs-6" id="transactionsModalLabel">
                    <i class="fas fa-exchange-alt me-1"></i>معاملات الحساب
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="transactionsContent">
                    <!-- Transactions will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enhanced Transaction Results Modal -->
<div class="modal fade" id="transactionResultsModal" tabindex="-1" aria-labelledby="transactionResultsModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <!-- UPDATED HEADER WITH #1a3a6c BACKGROUND -->
            <div class="modal-header text-white py-3" style="background-color: #1a3a6c; border-bottom: 2px solid #2c5e9c;">
                <h5 class="modal-title fs-5" id="transactionResultsModalLabel">
                    <i class="fas fa-list-alt me-2"></i>نتائج استعلام المعاملات - الفرع @ViewBag.userBranchCode
                </h5>
                <div class="btn-group">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div id="transactionResultsContent">
                    <!-- Enhanced content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

