                                        <div class="detail-item">
                                            <label class="fw-bold">إجمالي الدائن:</label>
                                            <span class="text-success fw-bold">
                                                ${account.credit.toFixed(2)}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="detail-item">
                                            <label class="fw-bold">الرصيد الإجمالي:</label>
                                            <span class="${account.balance >= 0 ? 'text-success' : 'text-danger'} fw-bold">
