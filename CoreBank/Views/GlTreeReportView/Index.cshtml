                        // Create a beautiful modal for account details
                        const detailsHtml = `
                            <div class="account-details-modal">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <label class="fw-bold">رقم الحساب:</label>
                                            <span>${account.glId || 'N/A'}</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <label class="fw-bold">اسم الحساب:</label>
                                            <span>${account.glName || 'N/A'}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-3">
