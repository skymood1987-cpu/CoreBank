@model IEnumerable<MinCoreBank.Models.GeneralLedgerAccount>

@{
    ViewData["Title"] = "إدارة تفاصيل الاستاذ العام ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="banking-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-exchange-alt fa-lg me-2"></i>@ViewData["Title"]
        </h1>
        <a href="@Url.Action("Create", "GeneralLedgerView")" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>إنشاء حساب جديد
        </a>
    </div>

    <!-- Accounts Table -->
    <div class="banking-card">
        <div class="card-header">
            <div class="row align-items-center g-3">
                <div class="col-lg-5 col-md-7">
                    <form method="get" asp-action="Index" asp-controller="GeneralLedgerView" class="input-group ledger-search-group">
                        <input type="text"
                               id="accountNumberSearch"
                               name="accountNumber"
                               class="form-control"
                               value="@ViewBag.AccountNumberSearch"
                               placeholder="ابحث برقم الحساب...">
                        <button class="btn btn-outline-secondary ledger-search-btn" type="submit" id="searchButton">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>
                <div class="col-lg-7 col-md-5 text-md-end">
                    <div class="d-inline-flex align-items-center gap-2 flex-wrap justify-content-md-end">
                        <div class="ledger-summary-chip">
                            <i class="fas fa-book me-1"></i>
                            إجمالي الحسابات: <strong>@Model.Count()</strong>
                        </div>
                        <div class="btn-group">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-filter me-1"></i>الحالة
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item filter-option" data-status="all">جميع الحسابات</a></li>
                            <li><a class="dropdown-item filter-option" data-status="active">نشطة فقط</a></li>
                            <li><a class="dropdown-item filter-option" data-status="closed">مغلقة فقط</a></li>
                        </ul>
                    </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover banking-table" id="accountsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم الحساب</th>
                            <th>الاسم بالعربية</th>
                            <th>الاسم بالإنجليزية</th>
                            <th>النوع</th>
                            
                            <th>الرصيد</th>
                            <th>الحالة</th>
                            <th>تاريخ الفتح</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model)
                        {
                            <tr data-status="@account.Status.ToLower()">
                                <td class="fw-bold">@account.Id</td>
                                <td>@account.NameAr</td>
                                <td>@account.NameEn</td>
                                <td>@account.Type</td>
                  
                                <td class="text-end">@account.Balance.ToString("N2")</td>
                                <td>
                                    <span class="badge @(account.Status == "active" ? "bg-success" : "bg-secondary")">
                                        @(account.Status == "active" ? "نشط" : "مغلق")
                                    </span>
                                </td>
                                <td>@account.OpeningDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Edit", "GeneralLedgerView", new { id = account.Id })" class="btn btn-outline-info">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "GeneralLedgerView", new { id = account.Id })" class="btn btn-outline-warning">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-book fa-3x text-muted mb-3"></i>
                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(ViewBag.AccountNumberSearch as string)
                            ? "لا توجد حسابات عامة مسجلة"
                            : $"لا توجد نتائج مطابقة لرقم الحساب: {ViewBag.AccountNumberSearch}")
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modals -->
<partial name="_CreateModal" />
<partial name="_EditModal" />
<partial name="_DeleteModal" />

@section Styles {
    <style>
        .banking-container {
            padding: 10px;
            min-height: calc(100vh - 120px);
        }

        .page-title {
            color: var(--ink);
            font-weight: 800;
            padding-bottom: 4px;
        }

        .banking-card {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 14px 28px rgba(10, 37, 74, 0.08);
            overflow: hidden;
        }

        .banking-card .card-header {
            background: linear-gradient(180deg, #fbfdff 0%, #f3f8ff 100%);
            border-bottom: 1px solid var(--line);
            padding: 16px 18px;
        }

        .banking-card .card-body {
            padding: 18px;
        }

        .ledger-search-group .form-control {
            background: #f8fbff;
            border-color: var(--line);
            min-height: 42px;
        }

        .ledger-search-btn {
            min-width: 46px;
            border-color: var(--line);
            color: #173a64;
            background: #f8fbff;
        }

        .ledger-summary-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 9px 14px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: #f6f9ff;
            color: #173a64;
            font-size: .88rem;
            font-weight: 700;
        }

        .banking-table th {
            background-color: #1a3a6c;
            color: white;
            border-color: #1a3a6c;
            font-weight: 700;
            text-align: center;
        }

        .banking-table td {
            vertical-align: middle;
        }

        .banking-table tbody tr:nth-child(even) {
            background: #fbfdff;
        }

        .btn-outline-secondary {
            color: #173a64;
            border-color: var(--line);
            background: #fff;
        }

        .btn-outline-secondary:hover {
            background-color: #eef4ff;
            border-color: #c8d7eb;
            color: #173a64;
        }

        .modal-header {
            background: linear-gradient(to right, #1a3a6c, #2c5282);
            color: white;
        }

        .form-label {
            font-weight: 500;
            color: #1a3a6c;
        }

        .table-responsive {
            border: 1px solid var(--line);
            border-radius: 14px;
            max-height: 600px;
            overflow-y: auto;
            overflow-x: auto;
        }

        .pagination {
            margin: 20px 0 0 0;
        }

        .page-link {
            color: #173a64;
            border: 1px solid var(--line);
            border-radius: 10px;
            margin: 0 2px;
        }

        .page-item.active .page-link {
            background: linear-gradient(90deg, #123c78, #0c2e61);
            border-color: #123c78;
            color: white;
        }

        .page-link:hover {
            color: #173a64;
            background-color: #eef4ff;
            border-color: #d5e1f0;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filter by status
            $('.filter-option').on('click', function() {
                const status = $(this).data('status');
                if (status === 'all') {
                    $('#accountsTable tbody tr').show();
                } else {
                    $('#accountsTable tbody tr').hide();
                    $(`#accountsTable tbody tr[data-status="${status}"]`).show();
                }
            });

            // Edit button click
            $('.edit-btn').on('click', function() {
                const accountId = $(this).data('id');
                loadAccountData(accountId);
            });

            // Delete button click
            $('.delete-btn').on('click', function() {
                const accountId = $(this).data('id');
                $('#deleteAccountId').val(accountId);
                $('#deleteModal').modal('show');
            });

            function filterTable() {
                const searchText = $('#accountNumberSearch').val().toLowerCase().trim();

                $('#accountsTable tbody tr').each(function() {
                    const accountId = $(this).find('td:eq(0)').text().toLowerCase().trim();
                    let matchesSearch = true;

                    // Check search text
                    if (searchText) {
                        matchesSearch = accountId.includes(searchText);
                    }

                    if (matchesSearch) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            function loadAccountData(accountId) {
                // Show loading state
                $('#editModal .modal-body').html(`
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">جاري التحميل...</span>
                        </div>
                        <p class="mt-2">جاري تحميل بيانات الحساب</p>
                    </div>
                `);
                $('#editModal').modal('show');

                // Fetch account data from API
                $.get(`/api/GeneralLedger/${accountId}`)
                    .done(function(data) {
                        populateEditForm(data);
                    })
                    .fail(function() {
                        $('#editModal .modal-body').html(`
                            <div class="alert alert-danger text-center">
                                فشل في تحميل بيانات الحساب. يرجى المحاولة مرة أخرى.
                            </div>
                        `);
                    });
            }

            function populateEditForm(account) {
                $('#editAccountId').val(account.id);
                $('#editNameAr').val(account.nameAr);
                $('#editNameEn').val(account.nameEn);
                $('#editStatus').val(account.status);
                $('#editInterestRate').val(account.interestRate);

                // Replace modal content with form
                $('#editModal .modal-body').html(`
                    <form id="editAccountForm">
                        <input type="hidden" id="editAccountId" />
                        <div class="mb-3">
                            <label for="editNameAr" class="form-label">الاسم بالعربية</label>
                            <input type="text" class="form-control" id="editNameAr" required>
                        </div>
                        <div class="mb-3">
                            <label for="editNameEn" class="form-label">الاسم بالإنجليزية</label>
                            <input type="text" class="form-control" id="editNameEn">
                        </div>
                        <div class="mb-3">
                            <label for="editStatus" class="form-label">الحالة</label>
                            <select class="form-select" id="editStatus" required>
                                <option value="active">نشط</option>
                                <option value="closed">مغلق</option>
                            </select>
                        </div>
                    </form>
                `);

                // Set values
                $('#editNameAr').val(account.nameAr);
                $('#editNameEn').val(account.nameEn);
                $('#editStatus').val(account.status);
                $('#editInterestRate').val(account.interestRate);
            }

            // Handle edit form submission
            $(document).on('submit', '#editAccountForm', function(e) {
                e.preventDefault();

                const accountId = $('#editAccountId').val();
                const formData = {
                    nameAr: $('#editNameAr').val(),
                    nameEn: $('#editNameEn').val(),
                    status: $('#editStatus').val(),
                    interestRate: parseFloat($('#editInterestRate').val()) || 0
                };

                $.ajax({
                    url: `/api/GeneralLedger/Updategl/${accountId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function() {
                        $('#editModal').modal('hide');
                        showAlert('تم تحديث الحساب بنجاح', 'success');
                        setTimeout(() => location.reload(), 1000);
                    },
                    error: function() {
                        showAlert('فشل في تحديث الحساب', 'danger');
                    }
                });
            });

            // Handle delete form submission
            $('#deleteForm').on('submit', function(e) {
                e.preventDefault();

                const accountId = $('#deleteAccountId').val();

                $.ajax({
                    url: `/api/GeneralLedger/deletegl/${accountId}`,
                    type: 'PUT',
                    success: function() {
                        $('#deleteModal').modal('hide');
                        showAlert('تم حذف الحساب بنجاح', 'success');
                        setTimeout(() => location.reload(), 1000);
                    },
                    error: function() {
                        showAlert('فشل في حذف الحساب', 'danger');
                    }
                });
            });

            function showAlert(message, type) {
                const alert = $(`
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `);

                $('.banking-container').prepend(alert);

                setTimeout(() => {
                    alert.alert('close');
                }, 5000);
            }
        });
    </script>
}
