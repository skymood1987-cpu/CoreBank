@model MinCoreBank.Models.GeneralLedgerAccount

@{
    ViewData["Title"] = "إنشاء استاذ عام جديد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="banking-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-plus-circle fa-lg me-2"></i>@ViewData["Title"]
        </h1>

    </div>

    <div class="banking-card">
        <div class="card-body">
            <form id="createAccountForm" asp-action="Create">
                <div class="row">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="Id" class="form-label">رقم الحساب <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="Id" name="Id" required>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="NameAr" class="form-label">الاسم بالعربية <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="NameAr" name="NameAr" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="NameEn" class="form-label">الاسم بالإنجليزية</label>
                            <input type="text" class="form-control" id="NameEn" name="NameEn">
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="Type" class="form-label">النوع <span class="text-danger">*</span></label>
                            <select class="form-select" id="Type" name="Type" required>
                                <option value="">اختر النوع</option>
                                <option value="A">أصول (A)</option>
                                <option value="L">خصوم (L)</option>
                                <option value="E">حقوق ملكية (E)</option>
                                <option value="R">إيرادات (R)</option>
                                <option value="X">مصروفات (X)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="Subtype" class="form-label">النوع الفرعي</label>
                            <input type="text" class="form-control" id="Subtype" name="Subtype">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="Currency" class="form-label">العملة <span class="text-danger">*</span></label>
                            <select class="form-select" id="Currency" name="Currency" required>
                                <option value="">اختر العملة</option>
                                <option value="IQD">دينار عراقي (IQD)</option>
                                <option value="USD">دولار أمريكي (USD)</option>
                                <option value="EUR">يورو (EUR)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">

                  
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="Status" class="form-label">الحالة <span class="text-danger">*</span></label>
                            <select class="form-select" id="Status" name="Status" required>
                                <option value="active">نشط</option>
                                <option value="closed">مغلق</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="Balance" class="form-label">الرصيد <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control" id="Balance" name="Balance" required value="0.00">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="AvailableBalance" class="form-label">الرصيد المتاح</label>
                            <input type="number" step="0.01" class="form-control" id="AvailableBalance" name="AvailableBalance" value="0.00">
                        </div>
                    </div>
                    <div class="col-md-4">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="OpeningDate" class="form-label">تاريخ الفتح <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="OpeningDate" name="OpeningDate" required>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>إنشاء الحساب
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">
                        <i class="fas fa-times me-2"></i>إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set today's date as default for opening date
            const today = new Date().toISOString().split('T')[0];
            $('#OpeningDate').val(today);

            // Handle form submission
            $('#createAccountForm').on('submit', function(e) {
                e.preventDefault();

                        const formData = {
           Id: parseInt($('#Id').val()),
            NameAr: $('#NameAr').val(),
            NameEn: $('#NameEn').val(),
            Type: $('#Type').val(),
            Subtype: $('#Subtype').val(),
            Currency: $('#Currency').val(),
            BranchId: '001', // You need to add this field to your form or set a default
            CustomerId:'000',
            Balance: parseFloat($('#Balance').val()),
            AvailableBalance: parseFloat($('#AvailableBalance').val()),
            OpeningDate: $('#OpeningDate').val(),
            Status: $('#Status').val()
        };
              //  console.alert(status);
                $.ajax({
                    url: '/api/GeneralLedger/creategl',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function() {
                        showAlert('تم إنشاء الحساب بنجاح', 'success');
                        setTimeout(() => window.location.href = '@Url.Action("Index")', 1000);
                    },
                    error: function(xhr) {
                        showAlert('فشل في إنشاء الحساب: ' + (xhr.responseJSON?.message || 'حدث خطأ'), 'danger');
                    }
                });
            });

            function showAlert(message, type) {
                const alert = $(`
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `);

                $('.banking-container').prepend(alert);

                setTimeout(() => {
                    alert.alert('close');
                }, 5000);
            }
        });
    </script>
}