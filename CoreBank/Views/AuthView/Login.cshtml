@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var appVersion = Configuration["AppInfo:Version"] ?? "1.0.0";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الدخول إلى النظام المصرفي</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --panel: rgba(255, 255, 255, 0.92);
            --line: rgba(202, 214, 232, 0.95);
            --ink: #112746;
            --muted: #627896;
            --brand: #123c78;
            --brand-2: #0c2e61;
            --focus: rgba(18, 60, 120, 0.18);
            --soft: #f5f8fc;
            --danger: #b42318;
            --danger-bg: #fff1f1;
            --success: #175c3d;
            --success-bg: #edf8f1;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            color: var(--ink);
            font-family: "Cairo", "Segoe UI", Tahoma, sans-serif;
            display: grid;
            place-items: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
            background: #eef3f9;
        }

        .login-video-bg {
            position: fixed;
            inset: 0;
            z-index: -2;
            overflow: hidden;
            pointer-events: none;
            background: #dfe7f3;
        }

        .login-video-bg video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: saturate(0.92) brightness(0.88);
        }

        .login-video-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(135deg, rgba(7, 24, 52, 0.72), rgba(12, 38, 78, 0.58)),
                radial-gradient(circle at top right, rgba(255, 255, 255, 0.10), transparent 30%);
        }

        .login-panel {
            width: min(406px, 100%);
            min-height: 512px;
            display: block;
            background: var(--panel);
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 28px 80px rgba(6, 23, 49, 0.26);
            backdrop-filter: blur(12px);
        }

        .form-logo {
            width: 68px;
            height: 68px;
            margin: 0 auto 10px;
            border-radius: 18px;
            overflow: hidden;
            background: #f4f8fd;
            border: 1px solid #d8e3f1;
            display: grid;
            place-items: center;
            box-shadow: 0 10px 22px rgba(18, 60, 120, 0.10);
        }

        .form-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .form-logo .fallback {
            display: none;
            font-size: 1.8rem;
            color: var(--brand);
        }

        .panel-form {
            padding: 34px 18px 28px;
            background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,253,0.96));
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-head {
            margin-bottom: 12px;
            text-align: center;
        }

        .form-head h1 {
            margin: 0;
            font-size: 1.45rem;
            font-weight: 800;
            color: #173760;
        }

        .form-head p {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 0.88rem;
            line-height: 1.8;
            font-weight: 600;
        }

        .login-form {
            max-width: 100%;
            width: 100%;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 10px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.88rem;
            font-weight: 700;
            color: #1b3a62;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #6d819f;
            font-size: 0.95rem;
            pointer-events: none;
        }

        input[type="text"],
        input[type="password"] {
            width: 100%;
            height: 44px;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 0 44px 0 52px;
            font-size: 0.94rem;
            outline: none;
            background: var(--soft);
            color: var(--ink);
            transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
        }

        input:focus {
            border-color: #4470ab;
            box-shadow: 0 0 0 4px var(--focus);
            background: #fff;
        }

        .password-toggle {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #5f7594;
            cursor: pointer;
            font-size: .95rem;
            width: 30px;
            height: 30px;
            border-radius: 8px;
        }

        .password-toggle:hover {
            background: rgba(18, 60, 120, 0.08);
        }

        .submit-btn {
            width: 100%;
            height: 44px;
            border: none;
            border-radius: 12px;
            color: #fff;
            font-size: 0.94rem;
            font-weight: 800;
            background: linear-gradient(90deg, var(--brand), var(--brand-2));
            box-shadow: 0 16px 28px rgba(12, 46, 95, 0.18);
            cursor: pointer;
            margin-top: 4px;
        }

        .submit-btn:hover {
            background: linear-gradient(90deg, #164989, #0f356f);
        }

        .submit-btn:disabled {
            opacity: .8;
            cursor: wait;
        }

        .helper-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            margin-top: 2px;
            margin-bottom: 4px;
            color: var(--muted);
            font-size: .78rem;
            font-weight: 700;
        }

        .caps-warning {
            display: none;
            color: #9a630c;
        }

        .msg {
            display: none;
            margin-top: 10px;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 700;
            font-size: .84rem;
            line-height: 1.8;
        }

        .msg-error {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1px solid rgba(180, 35, 24, 0.14);
        }

        .msg-success {
            background: var(--success-bg);
            color: var(--success);
            border: 1px solid rgba(23, 92, 61, 0.14);
        }

        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, 0.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .8s linear infinite;
            margin-left: 8px;
            vertical-align: -3px;
        }

        .login-foot {
            margin-top: 8px;
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.8;
            font-weight: 700;
            text-align: center;
        }

        .login-version {
            margin-top: 8px;
            color: #7388a5;
            font-size: .74rem;
            font-weight: 700;
            text-align: center;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        @@media (max-width: 940px) {
            .login-panel {
                width: min(406px, 100%);
            }

            .panel-form {
                padding: 30px 16px 24px;
            }
        }

        @@media (max-width: 560px) {
            body {
                padding: 12px;
            }

            .panel-form {
                padding: 28px 14px 24px;
            }

            .helper-row {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="login-video-bg" aria-hidden="true">
        <video autoplay muted loop playsinline preload="metadata">
            <source src="https://storage.nodesbox.com/agbank.gov.iq/2024/11/24/2024_11_24_12127047443_2307012050424640.mp4" type="video/mp4" />
        </video>
        <div class="login-video-overlay"></div>
    </div>

    <div class="login-panel">
        <section class="panel-form">
            <div class="form-logo">
                <img src="~/assets/logo/bank-logo.jpg" alt="شعار المصرف" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                <span class="fallback"><i class="fas fa-building-columns"></i></span>
            </div>
            <div class="form-head">
                <h1>تسجيل الدخول</h1>
                <p>يرجى إدخال بيانات المستخدم للمتابعة إلى النظام.</p>
            </div>

            <form id="loginForm" class="login-form">
                <div class="form-group">
                    <label for="username">اسم المستخدم</label>
                    <div class="input-wrap">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input type="text" id="username" name="username" required autocomplete="username" placeholder="أدخل اسم المستخدم">
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">كلمة المرور</label>
                    <div class="input-wrap">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="أدخل كلمة المرور">
                        <button type="button" class="password-toggle" id="togglePassword" aria-label="إظهار كلمة المرور">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="helper-row">
                    <span>تأكد من لغة الإدخال قبل المتابعة</span>
                    <span class="caps-warning" id="capsWarning">زر Caps Lock مفعل</span>
                </div>

                <button type="submit" id="loginButton" class="submit-btn">
                    <span id="submitText">دخول</span>
                </button>
            </form>

            <div id="errorMessage" class="msg msg-error"></div>
            <div id="successMessage" class="msg msg-success"></div>

            <div class="login-foot">
                في حال تعذر تسجيل الدخول، يرجى مراجعة مسؤول النظام أو شعبة البرمجة.
            </div>
            <div class="login-version">الإصدار @appVersion</div>
        </section>
    </div>

    <script>
        const loginForm = document.getElementById('loginForm');
        const loginButton = document.getElementById('loginButton');
        const submitText = document.getElementById('submitText');
        const errorMessage = document.getElementById('errorMessage');
        const successMessage = document.getElementById('successMessage');
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const capsWarning = document.getElementById('capsWarning');

        const HOME_FALLBACK = '/Dashboard/Index';

        togglePassword.addEventListener('click', function () {
            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
            const icon = this.querySelector('i');
            icon.className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
        });

        passwordInput.addEventListener('keydown', function (event) {
            if (event.getModifierState) {
                capsWarning.style.display = event.getModifierState('CapsLock') ? 'inline' : 'none';
            }
        });

        passwordInput.addEventListener('keyup', function (event) {
            if (event.getModifierState) {
                capsWarning.style.display = event.getModifierState('CapsLock') ? 'inline' : 'none';
            }
        });

        window.addEventListener('DOMContentLoaded', async () => {
            try {
                const response = await fetch('/api/Auth/check-auth', { method: 'GET', credentials: 'include' });
                const authData = await response.json();
                if (authData.authenticated) {
                    window.location.href = HOME_FALLBACK;
                }
            } catch {
            }
        });

        loginForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const username = document.getElementById('username').value.trim();
            const password = passwordInput.value;

            hideMessages();
            if (!username || !password) {
                showError('الرجاء إدخال اسم المستخدم وكلمة المرور.');
                return;
            }

            setLoadingState(true);
            try {
                const response = await fetch('/api/Auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ username: username, Password: password }),
                    credentials: 'include'
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    showSuccess('تم تسجيل الدخول بنجاح.');
                    window.location.href = `${(data.redirectUrl || HOME_FALLBACK)}?t=${Date.now()}`;
                    return;
                }

                showError(data.message || 'فشل تسجيل الدخول.');
                setLoadingState(false);
            } catch {
                showError('حدث خطأ في الاتصال.');
                setLoadingState(false);
            }
        });

        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.style.display = 'block';
        }

        function showSuccess(message) {
            successMessage.textContent = message;
            successMessage.style.display = 'block';
        }

        function hideMessages() {
            errorMessage.style.display = 'none';
            successMessage.style.display = 'none';
        }

        function setLoadingState(isLoading) {
            if (isLoading) {
                loginButton.disabled = true;
                const spinner = document.createElement('span');
                spinner.className = 'loading-spinner';
                submitText.textContent = 'جاري الدخول';
                submitText.prepend(spinner);
            } else {
                loginButton.disabled = false;
                submitText.textContent = 'دخول';
            }
        }

        document.getElementById('username').focus();
    </script>
</body>
</html>
