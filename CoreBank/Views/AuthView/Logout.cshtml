@{
    ViewData["Title"] = "تسجيل الخروج";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="banking-container">
    <div class="row justify-content-center">
        <div class="col-12 logout-card-wrap">
            <div class="banking-card">
                <div class="card-header text-center">
                    <h4 class="mb-0">
                        <i class="fas fa-right-from-bracket me-2"></i>تسجيل الخروج
                    </h4>
                </div>

                <div class="card-body text-center py-4">
                    <h5 class="mb-3">هل أنت متأكد من تسجيل الخروج؟</h5>
                    <p class="text-muted mb-4">
                        سيتم إنهاء الجلسة الحالية، وستحتاج إلى تسجيل الدخول مرة أخرى.
                    </p>

                    <div class="user-info mb-4">
                        <i class="fas fa-user-circle me-2"></i>
                        <span class="fw-bold">المستخدم:</span>
                        <span>@User.Identity?.Name</span>
                    </div>

                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <form action="/AuthView/LogoutConfirmed" method="post" id="logoutForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary" id="logoutBtn">
                                <i class="fas fa-right-from-bracket me-1"></i>تأكيد تسجيل الخروج
                            </button>
                        </form>

                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-right me-1"></i>إلغاء
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .banking-card {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: 0 12px 24px rgba(10, 37, 74, 0.08);
            min-height: 520px;
        }

        .logout-card-wrap {
            width: min(100%, 1320px);
            max-width: 1320px;
        }

        .banking-container {
            min-height: calc(100vh - 180px);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .banking-card .card-header {
            background: #f8fbff;
            border-bottom: 1px solid var(--line);
            padding: 26px 32px;
        }

        .banking-card .card-body {
            padding: 64px 56px !important;
        }

        .user-info {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 14px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #f8fbff;
            color: var(--ink);
            font-weight: 600;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#logoutBtn').on('click', function(e) {
                e.preventDefault();
                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>جاري تسجيل الخروج...');
                $('#logoutForm')[0].submit();
            });
        });
    </script>
}
