<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MinCore_Bank_system</title>

    <!-- Bootstrap CSS RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Custom CSS for RTL -->
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            text-align: right;
            direction: rtl;
        }

        .navbar-brand {
            font-weight: bold;
            color: #1a3a6c !important;
        }

        .main-container {
            min-height: calc(100vh - 120px);
            padding: 20px 0;
        }

        .footer {
            background-color: #1a3a6c;
            color: white;
            padding: 15px 0;
            margin-top: auto;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="rtl-header">
        <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(to right, #1a3a6c, #2c5282);">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "GlTransactionsView")" style="color: white !important;">
                    <i class="fas fa-university ms-2"></i> MinCoreBank
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "GlTransactionsView" ? "active" : "")"
                               href="@Url.Action("Index", "GlTransactionsView")">
                                <i class="fas fa-home ms-1"></i> الرئيسية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "GlTreeReportView" ? "active" : "")"
                               href="@Url.Action("Index", "GlTreeReportView")">
                                <i class="fas fa-sitemap ms-1"></i> تقارير الاستاذ العام
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DailyBranchApprovalView" ? "active" : "")"
                               href="@Url.Action("Index", "DailyBranchApprovalView")">
                                <i class="fas fa-sitemap ms-1"></i> اجراءات نهاية اليوم  
                            </a>
                        </li>
                        @if (User.IsInRole("admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "GeneralLedgerView" ? "active" : "")"
                                   href="@Url.Action("Index", "GeneralLedgerView")">
                                    <i class="fas fa-book ms-1"></i> ادارة الاستاذ العام
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "UsersView" ? "active" : "")"
                                   href="@Url.Action("Index", "UsersView")">
                                    <i class="fas fa-users ms-1"></i> ادارة المستخدمين
                                </a>
                            </li>

                            
                        }
                    </ul>

                    <!-- User info and logout section -->
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Logout", "AuthView")">
                                            <i class="fas fa-sign-out-alt me-1"></i>تسجيل الخروج
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "AuthView")">
                                    <i class="fas fa-sign-in-alt me-1"></i>تسجيل الدخول
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-container">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container text-center">
            <p>  نظام إدارة  الاستاذ العام- 2025_&copy; Min Core Bank   </p>
        </div>
    </footer>

    <!-- Bootstrap & jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>